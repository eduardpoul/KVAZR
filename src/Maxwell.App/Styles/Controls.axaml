<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Shared surface and type styles, taken from the Claude Design canvas: cards are
    white on #F3F3F3 with an 8px radius and a hairline border, rows are 1px-divided
    inside a card, and the type scale is 11/12/13/14 with 28 for the big numbers.
  -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource LayerCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
  </Style>

  <Style Selector="Border.card > StackPanel">
    <Setter Property="Margin" Value="20" />
  </Style>

  <!-- A row inside a card: title on the left, control on the right.
       ColumnDefinitions is a CLR property rather than an AvaloniaProperty, so it
       cannot be set here and each Grid declares it directly. -->
  <Style Selector="Grid.row">
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <Style Selector="Separator.divider">
    <Setter Property="Background" Value="{DynamicResource StrokeSubtleBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <!--
    The page title. 28 from the artboard, not 20 from a hand-picked step on the type
    scale: at 20 it read as a section heading rather than as the name of the screen, and
    every page was eleven pixels short before its first card as a result.
  -->
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource DashTitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.28" />
    <Setter Property="LineHeight" Value="{DynamicResource PageTitleLine}" />
  </Style>

  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.bigNumber">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Small status pill, used for "Not connected", "Not answering" and similar. -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="Border.pill.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
  </Style>

  <Style Selector="Border.pill.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <!--
    Segmented choice, used for noise reduction (off / low / high) and the theme
    picker. The design draws these as bordered tiles that fill with the accent tint
    when active, not as radio buttons.
  -->
  <!--
    One joined control with hairlines between the segments, as artboard 7a draws it —
    not three buttons standing next to each other. The difference matters: three buttons
    read as three separate things one could do, and this is one thing with three states.
  -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource LayerCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SegmentRadiusCorner}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <!--
    Sized by their labels, not by a fixed width. The widths in artboard 7a — 84 and 72 —
    are what its three labels come to at this size plus this padding, and lifting the
    numbers instead of the rule clipped any label longer than the theme names: the
    microphone's "Off · Low · High" lost half its last word.
  -->
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Height" Value="{DynamicResource SegmentHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{DynamicResource SegmentSize}" />
  </Style>

  <!-- The first segment has nothing to its left to be divided from. -->
  <Style Selector="ListBox.segmented ListBoxItem:nth-child(1)">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
  </Style>

  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <!-- EQ preset tiles: same idea, wrapped and taller because they carry a subtitle. -->
  <Style Selector="ListBox.tiles">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.tiles ListBoxItem">
    <Setter Property="Width" Value="150" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
    <Setter Property="Background" Value="{DynamicResource LayerCardBrush}" />
  </Style>

  <Style Selector="ListBox.tiles ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!--
    Capability state decorations, from artboard 2a. They sit on the frame around the
    control rather than inside each control, so a toggle, a slider and a dropdown all
    show an unmet precondition the same way.
  -->

  <Style Selector="Border.capControl">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <!-- Dimmed, not hidden: the device has the feature, the precondition is missing. -->
  <Style Selector="Border.capControl.blocked">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Border.capControl.pending">
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- The one place red is allowed: the device actually refused a write. -->
  <Style Selector="Border.capControl.error">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBorderBrush}" />
  </Style>

  <!-- The value moved on the device itself. Acknowledged, briefly, rather than
       silently overwritten. -->
  <Style Selector="Border.capControl.external">
    <Setter Property="BoxShadow" Value="0 0 0 3 #380F6CBD" />
  </Style>

  <!--
    Composite primitives: the parts of a capability that has several at once. They share
    the frame and the hint line with every other control, so what is left here is only
    the geometry of the parts themselves.
  -->

  <!-- Lighting colours. A ring rather than a fill for the selection, because filling a
       swatch would change the colour it is there to show. -->
  <Style Selector="ListBox.swatches">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <!-- Sized explicitly, including the minimum. The base theme gives a list item a
       minimum width meant for a row of text, and eight colour chips inherited it and
       spread themselves across the panel with five of them off the end. -->
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />

    <!-- The padding is the gap between the selection ring and the colour. Without it a
         blue swatch selected in an accent-blue ring is a blue square with a blue edge,
         which is to say no ring at all. -->
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- A hairline round every chip. White is a colour a keyboard can be set to, and on a
       white card an unbordered white swatch is a hole in the row rather than an option. -->
  <Style Selector="ListBox.swatches ListBoxItem > Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
  </Style>

  <Style Selector="ListBox.swatches ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Keyboard layer tabs. Narrower than the segmented choice above: four of them have
       to sit over a key grid without being wider than it. -->
  <Style Selector="ListBox.layers">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.layers ListBoxItem">
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
    <Setter Property="Background" Value="{DynamicResource LayerCardBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  </Style>

  <Style Selector="ListBox.layers ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
  </Style>

  <!-- One key of a layout. Sized so a full row of a compact board fits the panel the
       design gives it, and legible at that size only because the legends are short. -->
  <Style Selector="Border.keycap">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
    <Setter Property="Background" Value="{DynamicResource LayerAltBrush}" />
  </Style>

  <Style Selector="Border.keycap.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!-- A key nobody has read. Blank, not zeroed: a cap printed with something the
       keyboard never reported is the same lie a slider showing 0 would be. -->
  <Style Selector="Border.keycap.unread">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
  </Style>

  <Style Selector="Border.keycap > TextBlock">
    <Setter Property="FontSize" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- The button on a profile or host slot. Small, because there is one per row. -->
  <Style Selector="Button.slot">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A free slot is an invitation, not a setting. Muted so the occupied rows read
       first, and never red: an empty profile is not a fault. -->
  <Style Selector="Grid.slot.empty TextBlock.cardTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- Root navigation entry, above the device groups, and the pinned row below them. -->
  <Style Selector="Button.navRoot">
    <Setter Property="Height" Value="{DynamicResource RailRowHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RailRowRadiusCorner}" />
    <Setter Property="FontSize" Value="{DynamicResource RailRowSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.navRoot:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
  </Style>

  <!-- The row for the screen already open. Held rather than hovered, so it survives the
       pointer moving away — this is where the user is, not what they are pointing at. -->
  <Style Selector="Button.navRoot.current /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LayerSelectedBrush}" />
  </Style>

  <!--
    A device in the pane. Deliberately not a ListBoxItem: the pane's two groups are two
    lists, and with a bound SelectedItem on each they clear one another's highlight. It
    is a button because it does one thing — open that device.
  -->
  <Style Selector="Button.railRow">
    <Setter Property="Height" Value="{DynamicResource RailRowHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RailRowRadiusCorner}" />
    <Setter Property="FontSize" Value="{DynamicResource RailRowSize}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Button.railRow:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="Height" Value="{DynamicResource RailSearchHeight}" />
    <Setter Property="Padding" Value="0,0,10,0" />
    <Setter Property="FontSize" Value="{DynamicResource RailSearchSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RailRowRadiusCorner}" />
  </Style>

  <!-- The button that does the irreversible thing. Marked, not hidden: the user chose
       to open this dialog, and hiding the consequence would be worse than naming it. -->
  <!-- The one filled button. There is at most one per screen, because a second thing
       shouting for the same attention means neither is the obvious next step. -->
  <!-- No "On"/"Off" beside the switch. The artboards never show it, and the label to
       its left already says what the switch is for — the word only repeats the position
       of the thumb in a second, slower way, and it does so in English. -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />

    <!-- And no minimum height either.
         Fluent's switch asks for the room a switch with a label beside it would need, and
         this one has no label: it measured taller than the thirty-pixel row it sits in, so
         it was arranged at thirty and clipped. What that looks like is a pill with square
         corners and a knob touching both edges — which is exactly how it looked. -->
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- A white knob on the accent, in both themes, because that is what the artboards
       draw and because the pane draws it that way too.

       Windows itself would put a black knob on a light accent in the dark theme — the
       switch inherits "text on accent", which is black there — and the panel duly did,
       beside a page whose switches were white. One product, two switches. The artboard
       is the arbiter, and it says white. -->
  <Styles.Resources>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FFFFFF" />
  </Styles.Resources>

  <Style Selector="Button.accent">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

</Styles>
