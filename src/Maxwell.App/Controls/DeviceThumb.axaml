<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Maxwell.App.Controls"
             x:Class="Maxwell.App.Controls.DeviceThumb"
             x:DataType="ctl:DeviceThumb"
             x:CompileBindings="True">

  <!--
    A photograph if we curated one for this model, the class silhouette otherwise. Never
    both, and never neither: an empty tile in a device row reads as a rendering fault
    rather than as a device nobody has photographed.
  -->
  <Panel>
    <!--
      A photograph gets a light plate in both themes, which is what the design does and
      not an oversight: product shots are lit for white, and a black headset on a dark
      surface is a black rectangle. A silhouette needs the opposite — it is ink, and it
      belongs on whatever surface the theme is using — so the plate is drawn only under
      the photograph.
    -->
    <Border Background="#F4F4F4"
            IsVisible="{Binding $parent[ctl:DeviceThumb].Photo, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Image Source="{Binding $parent[ctl:DeviceThumb].Photo}"
           IsVisible="{Binding $parent[ctl:DeviceThumb].Photo, Converter={x:Static ObjectConverters.IsNotNull}}"
           Stretch="Uniform"
           Margin="2" />

    <Path Data="{Binding $parent[ctl:DeviceThumb].Glyph}"
          IsVisible="{Binding $parent[ctl:DeviceThumb].Photo, Converter={x:Static ObjectConverters.IsNull}}"
          Stroke="{DynamicResource TextFillColorSecondaryBrush}"
          StrokeThickness="1.6"
          StrokeLineCap="Round"
          StrokeJoin="Round"
          Stretch="Uniform"
          Margin="3"
          HorizontalAlignment="Center"
          VerticalAlignment="Center" />
  </Panel>
</UserControl>
