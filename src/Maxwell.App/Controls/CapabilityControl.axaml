<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cap="using:Maxwell.App.ViewModels.Capabilities"
             xmlns:controls="using:Maxwell.App.Controls"
             xmlns:conv="using:Maxwell.App.Converters"
             xmlns:devices="using:Maxwell.Core.Devices"
             x:Class="Maxwell.App.Controls.CapabilityControl"
             x:DataType="cap:CapabilityViewModel">

  <!--
    The control itself plus every one of the eight states: dimmed when a precondition
    is unmet, an amber dot while untested, a red border when the device refused, a ring
    when the value moved on the hardware, a triangle before an irreversible write.

    They live on this frame rather than inside each control, because they are the same
    eight everywhere and a per-control implementation is a per-control chance to get one
    of them wrong.
  -->

  <UserControl.Resources>
    <conv:HintToneBrushConverter x:Key="HintTone" />
    <conv:PackedColorBrushConverter x:Key="PackedColour" />
    <conv:PresenceOpacityConverter x:Key="ReadOpacity" />
  </UserControl.Resources>

  <!-- One template per primitive, holding nothing but the control itself. Everything
       about state lives in the frame below, so these stay this short. -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="cap:ReadoutCapabilityViewModel">
      <TextBlock Classes="value" Text="{Binding Display}" />
    </DataTemplate>

    <DataTemplate DataType="cap:ToggleCapabilityViewModel">
      <ToggleSwitch IsChecked="{Binding IsOn}"
                    IsEnabled="{Binding CanEdit}"
                    OnContent="" OffContent=""
                    VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate DataType="cap:RangeCapabilityViewModel">
      <StackPanel Width="220" Spacing="2">
        <TextBlock Classes="caption"
                   HorizontalAlignment="Right"
                   Text="{Binding Display}" />
        <!-- Bounds are declared before the value on purpose: a Slider clamps whatever
             it is handed to the range it holds at that moment, and widening the range
             afterwards does not give the value back. Tick snapping is deliberately off
             — the write rounds to an integer anyway, and snapping adds a second
             coercion that can move the value again behind the binding's back. -->
        <Slider Minimum="{Binding Minimum}"
                Maximum="{Binding Maximum}"
                IsEnabled="{Binding CanEdit}"
                Value="{Binding Value}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="cap:ChoiceCapabilityViewModel">
      <Panel>
        <ListBox Classes="segmented"
                 IsVisible="{Binding IsSegmented}"
                 ItemsSource="{Binding Options}"
                 SelectedItem="{Binding Selected}"
                 IsEnabled="{Binding CanEdit}"
                 VerticalAlignment="Center">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="devices:CapabilityChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ComboBox MinWidth="180"
                  IsVisible="{Binding !IsSegmented}"
                  ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Selected}"
                  IsEnabled="{Binding CanEdit}"
                  VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="devices:CapabilityChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="cap:ActionCapabilityViewModel">
      <Button Command="{Binding InvokeCommand}"
              IsEnabled="{Binding CanEdit}"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="12" Height="12"
                Stretch="Uniform"
                Stroke="{DynamicResource DangerBrush}"
                StrokeThickness="1.5"
                Data="M8 2.6 14.4 13.4H1.6L8 2.6Z"
                VerticalAlignment="Center"
                IsVisible="{Binding NeedsConfirmation}" />
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <!--
      The composites. They are wider and taller than the scalar controls, and every one
      of them is pinned to the same width so a page of mixed capabilities lines up and
      the showcase's columns stay columns.
    -->

    <DataTemplate DataType="cap:RangeGroupCapabilityViewModel">
      <ItemsControl Width="264" ItemsSource="{Binding Channels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="cap:GroupedRangeViewModel">
            <Grid ColumnDefinitions="54,*,50" Margin="0,1">
              <TextBlock Grid.Column="0" Classes="caption"
                         Text="{Binding Label}" VerticalAlignment="Center" />
              <!-- Bounds before value, as everywhere: a Slider clamps to the range it
                   holds at that instant and widening it later does not undo the clamp. -->
              <Slider Grid.Column="1"
                      Minimum="{Binding Minimum}"
                      Maximum="{Binding Maximum}"
                      IsEnabled="{Binding CanEdit}"
                      Value="{Binding Value}" />
              <TextBlock Grid.Column="2" Classes="caption"
                         TextAlignment="Right" TextWrapping="NoWrap"
                         Text="{Binding Display}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="cap:CurveCapabilityViewModel">
      <StackPanel Width="264" Spacing="3">
        <TextBlock Classes="caption" HorizontalAlignment="Right" Text="{Binding Display}" />
        <!-- Dimmed rather than blank when nothing has been read: the frame of an
             equaliser still tells the reader what the control is, while a flat line
             drawn at full strength would be a reading the device never gave. -->
        <controls:CurvePlot Height="62"
                            Opacity="{Binding HasCurve, Converter={StaticResource ReadOpacity}}"
                            Points="{Binding Points}"
                            IsEditable="{Binding CanEdit}"
                            PointCommand="{Binding MovePointCommand}"
                            LineBrush="{DynamicResource AccentPrimaryBrush}"
                            AreaBrush="{DynamicResource AccentSubtleBrush}"
                            GridBrush="{DynamicResource StrokeDefaultBrush}" />
        <TextBlock Classes="caption" Text="{Binding Scale}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="cap:LightingCapabilityViewModel">
      <ItemsControl Width="264" ItemsSource="{Binding Zones}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="cap:LightingZoneViewModel">
            <StackPanel Spacing="3" Margin="0,2">
              <TextBlock Classes="caption" Text="{Binding Label}" />
              <ListBox Classes="swatches"
                       ItemsSource="{Binding Palette}"
                       SelectedItem="{Binding Selected}"
                       IsEnabled="{Binding CanEdit}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="cap:LightingSwatch">
                    <Border Width="18" Height="18"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{Binding Packed, Converter={StaticResource PackedColour}}"
                            ToolTip.Tip="{Binding Name}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="cap:ButtonMapCapabilityViewModel">
      <ItemsControl Width="264" ItemsSource="{Binding Buttons}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="cap:ButtonAssignmentViewModel">
            <Grid ColumnDefinitions="104,*" Margin="0,2">
              <StackPanel Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="{Binding Label}" />
                <!-- A button the device itself repurposes says so here rather than in
                     the capability's one hint line, which belongs to the whole map. -->
                <TextBlock Classes="caption"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding Hint}"
                           IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Actions}"
                        SelectedItem="{Binding Selected}"
                        IsEnabled="{Binding CanEdit}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="devices:CapabilityChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="cap:KeyMapCapabilityViewModel">
      <StackPanel Width="264" Spacing="5">
        <!-- Switching a layer is a read, not a write: which layer is on screen is not a
             setting on the keyboard, so these tabs never carry the amber dot's promise. -->
        <ListBox Classes="layers"
                 ItemsSource="{Binding Layers}"
                 SelectedItem="{Binding ActiveLayer}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="cap:KeyLayer">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ItemsControl Width="{Binding GridWidth}"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding Keys}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="cap:KeyCapViewModel">
              <Border Classes="keycap"
                      Classes.selected="{Binding IsSelected}"
                      Classes.unread="{Binding IsUnread}"
                      ToolTip.Tip="{Binding Position}">
                <TextBlock Text="{Binding Legend}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ComboBox HorizontalAlignment="Stretch"
                  IsVisible="{Binding HasSelection}"
                  ItemsSource="{Binding Keycodes}"
                  SelectedItem="{Binding Assignment}"
                  IsEnabled="{Binding CanEdit}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="devices:CapabilityChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </DataTemplate>

    <!-- One template for both slot lists. Profiles and hosts differ in their verbs and
         in nothing else, and the verbs come from the view model. -->
    <DataTemplate DataType="cap:SlotListCapabilityViewModel">
      <ItemsControl Width="264" ItemsSource="{Binding Slots}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="cap:CapabilitySlotViewModel">
            <Grid Classes="slot" Classes.empty="{Binding IsEmpty}"
                  ColumnDefinitions="*,Auto" Margin="0,3">

              <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Classes="cardTitle" FontSize="12" Text="{Binding Label}" />
                <TextBlock Classes="caption"
                           Text="{Binding Hint}"
                           IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <!-- The live slot has nowhere to go, so it carries a badge instead of a
                   button. A disabled "Применить" on the profile already applied is the
                   kind of dead control the design system exists to prevent. -->
              <Border Grid.Column="1" Classes="pill accent" IsVisible="{Binding IsActive}">
                <TextBlock Text="{Binding ActiveLabel}" />
              </Border>

              <Button Grid.Column="1" Classes="slot"
                      IsVisible="{Binding ShowsButton}"
                      IsEnabled="{Binding CanEdit}"
                      Command="{Binding SelectCommand}"
                      Content="{Binding Verb}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

  </UserControl.DataTemplates>

  <StackPanel Spacing="3" HorizontalAlignment="{Binding $parent[UserControl].HorizontalAlignment}">

    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

      <!-- Dimmed rather than hidden: the capability exists, the precondition does not.
           Hiding it would make the device look like it lacks the feature. -->
      <Border Classes="capControl"
              Classes.error="{Binding HasError}"
              Classes.external="{Binding ChangedExternally}"
              Classes.pending="{Binding IsWriting}"
              Classes.blocked="{Binding !IsAvailable}">
        <ContentControl Content="{Binding}" />
      </Border>

      <!-- The amber dot: command known, never confirmed on live hardware. It goes for
           good the first time the device accepts a write. -->
      <Ellipse Width="7" Height="7"
               Fill="{DynamicResource StatusUntestedBrush}"
               VerticalAlignment="Center"
               IsVisible="{Binding IsUntested}"
               ToolTip.Tip="Ещё не проверено на живом устройстве" />

      <!-- Warned before the write, never after. -->
      <Path Width="14" Height="14"
            Stretch="Uniform"
            Stroke="{DynamicResource StatusIrreversibleBrush}"
            StrokeThickness="1.5"
            Data="M8 2.6 14.4 13.4H1.6L8 2.6Z M8 6.4v3.2 M8 11.4h.01"
            VerticalAlignment="Center"
            IsVisible="{Binding IsIrreversible}"
            ToolTip.Tip="Эту запись нельзя отменить" />
    </StackPanel>

    <!-- One line, and the most urgent thing wins. A stack of badges becomes wallpaper
         the user stops reading. -->
    <TextBlock Classes="caption"
               MaxWidth="320"
               Text="{Binding Hint}"
               Foreground="{Binding HintTone, Converter={StaticResource HintTone}}"
               IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>

</UserControl>
