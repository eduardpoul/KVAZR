<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Maxwell.App.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <!-- The design has its own accent, so the Windows personalisation colour is
         deliberately ignored: otherwise sliders and switches come out in the user's
         system accent while our own text accent stays blue. -->
    <!--
         PreferSystemTheme is off, not missing: it re-applies the operating system's
         theme after App.ApplyTheme has run, so a stored Light or Dark preference was
         silently overruled and the setting could never take effect. Following the
         system is still the default — that is what ThemeVariant.Default does on its
         own — this just stops it being the only possibility.
    -->
    <sty:FluentAvaloniaTheme PreferSystemTheme="False"
                             PreferUserAccentColor="False"
                             CustomAccentColor="#0F6CBD" />
    <StyleInclude Source="avares://Maxwell/Styles/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Maxwell/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Maxwell/Themes/DeviceGlyphs.axaml" />
        <ResourceInclude Source="avares://Maxwell/Themes/FluentIcons.axaml" />
        <ResourceInclude Source="avares://Maxwell/Themes/Metrics.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
