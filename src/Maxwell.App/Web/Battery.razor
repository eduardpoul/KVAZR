@* The battery gauge of artboard 1a: a 26x13 shell, a cap, the fill green until the low
   threshold and amber under it. Absent entirely when there is no reading — a gauge
   drawn empty claims the device is flat, which is a different statement from "not
   read", and the dash next door already says that one. *@

@if (Percent is { } p)
{
  <svg class="gauge" width="30" height="13" viewBox="0 0 30 13">
    <rect x="0.7" y="0.7" width="24.6" height="11.6" rx="3" fill="none"
          stroke="var(--gauge-shell)" stroke-width="1.4" />
    <rect x="2.2" y="2.2" width="@(Math.Max(0.0, 21.6 * p / 100.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
          height="8.6" rx="1.5" fill="@(p <= Threshold ? "var(--warning)" : "var(--success)")" />
    <rect x="27" y="4" width="2.4" height="5" rx="1" fill="var(--gauge-shell)" />
    @if (Charging)
    {
      <path d="M14.6 2.2 10.8 7h2.6l-1.4 3.8L15.8 6h-2.6z" fill="#FFFFFF"
            stroke="rgba(0,0,0,0.35)" stroke-width="0.6" />
    }
  </svg>
}

@code {
  [Parameter] public int? Percent { get; set; }

  [Parameter] public bool Charging { get; set; }

  [Parameter] public int Threshold { get; set; } = 20;
}
