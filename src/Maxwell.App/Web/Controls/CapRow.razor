@namespace Maxwell.App.Web
@inherits ReactiveComponent
@using System.Globalization

@* One capability as a page row: name and explanation on the left, the control in a
   fixed 260 column on the right — except the table-shaped capabilities, which take the
   full width under their own name, exactly as artboards 9b and 9c give it to them.

   The state rules mirror the native row one for one: out of reach is one quiet line in
   place of the control; a slider is hidden until it has a reading; the amber dot marks
   a command never confirmed on hardware and leaves for good after the first accepted
   write; the warning triangle appears only while a write is actually possible. *@

<div class="cap-row @(Wide ? "wide" : "") @(Joined ? "joined" : "")">
  <div class="cap-text">
    <div class="cap-title-row">
      <span class="cap-title">@Vm.Title</span>
      @if (Vm.Badge is { } badge)
      {
        <span class="badge @BadgeClass(badge.Kind)">@badge.Text</span>
      }
    </div>
    @if (!string.IsNullOrEmpty(Vm.Subtitle))
    {
      <div class="caption wrap">@Vm.Subtitle</div>
    }
  </div>

  <div class="cap-control">
    @if (!Vm.IsAvailable)
    {
      <div class="blocked">@Vm.Unreachable</div>
    }
    else
    {
      <div class="cap-line">
        @switch (Vm)
        {
          case ReadoutCapabilityViewModel { IsMeter: true } meter:
            @* Segmented, per the artboard: a run of lit blocks rather than a solid bar,
               which is how every meter on a mixing desk has looked for fifty years and
               therefore reads as movement even out of the corner of an eye. The lit part
               is the same pattern in green, clipped to the level, so the blocks line up
               exactly with the unlit ones behind them. *@
            <div class="meter">
              <div class="meter-track">
                <div class="meter-fill @MeterTone(meter.Fill)" style="width:@Percent(meter.Fill)%"></div>
              </div>
              <span class="meter-value">@Percent(meter.Fill)%</span>
            </div>
            break;

          case ReadoutCapabilityViewModel readout:
            <span class="value">@readout.Display</span>
            break;

          case ToggleCapabilityViewModel toggle:
            <button class="switch @(toggle.IsOn ? "on" : "")"
                    disabled="@(!toggle.CanEdit)"
                    @onclick="() => OnUi(() => toggle.IsOn = !toggle.IsOn)">
              <span class="knob"></span>
            </button>
            break;

          case RangeCapabilityViewModel range:
            <div class="range @(range.CanMute ? "with-icon" : "") @(range.IsMuted ? "muted" : "")">
              @if (range.CanMute)
              {
                @* The protocol has no mute, so this writes the floor and keeps the level
                   to come back to. Crossed out while silent, and the track goes quiet
                   with it — still showing where it will return to. *@
                <button class="slider-icon" disabled="@(!range.CanEdit)"
                        title="@(range.IsMuted ? "Unmute" : "Mute")"
                        @onclick="() => OnUi(() => range.ToggleMuteCommand.Execute(null))">
                  @if (range.IsMuted)
                  {
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M8.4 3 5.2 6H2.6v4h2.6l3.2 3Z" /><path d="M11 6 14 9.4M14 6l-3 3.4" /></svg>
                  }
                  else
                  {
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M8.4 3 5.2 6H2.6v4h2.6l3.2 3Z" /><path d="M11 6.2c1.1 1 1.1 2.6 0 3.6" /><path d="M12.9 4.6c2 1.9 2 4.9 0 6.8" /></svg>
                  }
                </button>
              }
              <div class="reading">@range.Display</div>
              @if (range.HasValue)
              {
                <div class="slider-wrap">
                  <input type="range" min="@Inv(range.Minimum)" max="@Inv(range.Maximum)" step="1"
                         value="@Inv(range.Value)" disabled="@(!range.CanEdit || range.IsMuted)"
                         style="--fill:@Fill(range.Value, range.Minimum, range.Maximum)%"
                         @oninput="e => OnUi(() => range.Value = Parse(e))" />
                  @foreach (int detent in range.Detents)
                  {
                    <span class="detent" style="left:@Fill(detent, range.Minimum, range.Maximum)%"></span>
                  }
                </div>
              }
            </div>
            break;

          case ChoiceCapabilityViewModel { IsSegmented: true } segmented:
            <div class="segmented">
              @foreach (CapabilityChoice option in segmented.Options)
              {
                <button class="@(ReferenceEquals(segmented.Selected, option) ? "sel" : "")"
                        disabled="@(!segmented.CanEdit)"
                        @onclick="() => OnUi(() => segmented.Selected = option)">@option.Label</button>
              }
            </div>
            break;

          case ChoiceCapabilityViewModel choice:
            <Dropdown Items="@([.. choice.Options.Select(o => o.Label)])"
                      Disabled="@(!choice.CanEdit)"
                      SelectedIndex="@(choice.Selected is { } sel ? IndexIn(choice.Options, sel) : -1)"
                      SelectedIndexChanged="i => OnUi(() => choice.Selected = choice.Options.ElementAtOrDefault(i))" />
            break;

          case ActionCapabilityViewModel action:
            <button class="outline @(action.NeedsConfirmation ? "risky" : "")"
                    disabled="@(!action.CanEdit)"
                    @onclick="() => OnUi(() => action.InvokeCommand.Execute(null))">
              @if (action.NeedsConfirmation)
              {
                <svg width="12" height="12" viewBox="0 0 16 16"><path d="M8 2.6 14.4 13.4H1.6Z" fill="none" stroke="var(--danger)" stroke-width="1.5" /></svg>
              }
              @action.Label
            </button>
            break;

          case RangeGroupCapabilityViewModel grouped:
            <div class="range-group">
              @foreach (GroupedRangeViewModel channel in grouped.Channels)
              {
                <div class="range-track">
                  <span class="caption">@channel.Label</span>
                  @if (channel.HasValue)
                  {
                    <input type="range" min="@Inv(channel.Minimum)" max="@Inv(channel.Maximum)" step="1"
                           value="@Inv(channel.Value)" disabled="@(!channel.CanEdit)"
                           style="--fill:@Fill(channel.Value, channel.Minimum, channel.Maximum)%"
                           @oninput="e => { var c = channel; OnUi(() => c.Value = Parse(e)); }" />
                  }
                  <span class="reading">@channel.Display</span>
                </div>
              }
            </div>
            break;

          case CurveCapabilityViewModel curve:
            <div class="curve">
              <div class="curve-head">
                <span class="curve-reading">@curve.Display</span>
                @if (curve.IsWriting)
                {
                  <span class="badge pending busy">@T["curve.applying", "applying"]</span>
                }
                else if (curve.IsDirty)
                {
                  <span class="badge warn">@T["curve.unsaved", "unsaved"]</span>
                }
                <span class="curve-tools">
                  @if (curve.IsDirty)
                  {
                    <button class="icon-btn" title="@T["curve.revert", "Put the preset curve back"]"
                            @onclick="() => OnUi(() => curve.RevertCommand.Execute(null))">
                      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2.5 8a5.5 5.5 0 1 0 1.7-4"/>
                        <path d="M2.2 2.4v3.4h3.4"/>
                      </svg>
                    </button>
                  }
                  @if (curve.CanSave)
                  {
                    @* Filled rather than stroked. The outlined version drew nothing here
                       and no amount of reading the stylesheet explained it; a solid shape
                       needs neither a stroke width nor a fill rule to survive whatever was
                       eating it. *@
                    <button class="icon-btn accent" title="@T["curve.save", "Save preset"]"
                            @onclick="() => OnUi(() => curve.BeginSaveCommand.Execute(null))">
                      <svg class="solid" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M2 2h8.2L14 5.8V14H2V2zm3 .8v3.4h4.2V2.8H5zm-.4 10.4V9.4h6.8v3.8H4.6z"/>
                      </svg>
                    </button>
                  }
                  @if (curve.CanDelete)
                  {
                    <button class="icon-btn danger" title="@T["curve.delete", "Delete preset"]"
                            @onclick="() => OnUi(() => curve.DeletePresetCommand.Execute(null))">
                      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 4.5h10M6.5 4.5v-2h3v2M4.5 4.5l.7 9a1 1 0 0 0 1 .9h3.6a1 1 0 0 0 1-.9l.7-9"/>
                      </svg>
                    </button>
                  }
                  @if (curve.Presets.Count > 0)
                  {
                    @* The application's own dropdown, not a native select: the operating
                       system draws that one and will not take the page's palette, so its
                       list came out grey on grey and read as disabled. *@
                    <Dropdown Items="@([.. curve.Presets.Select(PresetLabel)])"
                              Disabled="@(!curve.CanEdit)"
                              SelectedIndex="@curve.SelectedPresetIndex"
                              SelectedIndexChanged="i => OnUi(() => curve.ChoosePresetCommand.Execute(i))" />
                  }
                </span>
              </div>
              @if (curve.IsNaming)
              {
                @* Artboard "Save preset": a dialog over the window, with a title, a
                   sentence saying where the curve goes, one labelled field and the two
                   buttons bottom right. It was a row inside the card first, which is not
                   what the artboard draws and not what the reader expects of a name they
                   are being asked for. *@
                <div class="scrim" @onclick="() => OnUi(() => curve.CancelSaveCommand.Execute(null))"></div>
                <div class="dialog" role="dialog" aria-modal="true">
                  <h2>@T["dialog.save_title", "Save preset"]</h2>
                  <p>@T["dialog.save_body", "The ten bands will be kept in this application under the name you choose."]</p>
                  <label for="preset-name">@T["dialog.name_label", "Preset name"]</label>
                  <input id="preset-name" @ref="_nameField" placeholder="@T["dialog.name_placeholder", "For example, Night"]"
                         value="@curve.PendingName"
                         @oninput="e => { var c = curve; OnUi(() => c.PendingName = e.Value?.ToString() ?? string.Empty); }"
                         @onkeydown="e => { var c = curve; OnUi(() => NameKey(c, e)); }" />
                  <div class="dialog-actions">
                    <button class="outline"
                            @onclick="() => OnUi(() => curve.CancelSaveCommand.Execute(null))">@T["dialog.cancel", "Cancel"]</button>
                    <button class="accent" disabled="@(string.IsNullOrWhiteSpace(curve.PendingName))"
                            @onclick="() => OnUi(() => curve.ConfirmSaveCommand.Execute(null))">@T["dialog.save", "Save"]</button>
                  </div>
                </div>
              }
              @if (curve.HasCurve)
              {
                @* The readings go above the frame, as the artboard has them, and not inside
                   it. Printed over the plot they landed on top of the rails the moment the
                   rails became full height — a caption with a track running through it. *@
                <div class="plot-frame values">
                  <div class="plot-axis"></div>
                  <div class="plot-values">
                    @for (int i = 0; i < curve.Values.Count; i++)
                    {
                      <span class="band-value @(curve.SelectedBand == i ? "sel" : "")">@curve.BandText(i)</span>
                    }
                  </div>
                </div>
                <div class="plot-frame">
                  <div class="plot-axis">
                    @foreach (string tick in curve.AxisTicks)
                    {
                      <span>@tick</span>
                    }
                  </div>
                  <div class="plot">
                    <span class="grid at-25"></span>
                    <span class="grid at-75"></span>
                    <span class="grid zero" style="bottom:@Pct(curve.ZeroFraction)"></span>
                    @for (int i = 0; i < curve.Points.Count; i++)
                    {
                      int band = i;
                      double point = curve.Points[i];
                      double zero = curve.ZeroFraction;
                      bool active = curve.SelectedBand == band;

                      <div class="band @(active ? "sel" : "")"
                           @onpointerdown="e => Move(curve, band, e)"
                           @onpointermove="e => { if (e.Buttons == 1) Move(curve, band, e); }">
                        <span class="band-bar @(Math.Abs(point - zero) < 0.005 ? "flat" : "")"
                              style="bottom:@Pct(Math.Min(point, zero));height:@Pct(Math.Abs(point - zero))"></span>
                        <span class="band-knob" style="bottom:calc(@Pct(point) - 9px)"></span>
                      </div>
                    }
                  </div>
                </div>
                <div class="plot-frame labels">
                  <div class="plot-axis"></div>
                  <div class="plot-labels">
                    @for (int i = 0; i < curve.Labels.Count; i++)
                    {
                      <span class="@(curve.SelectedBand == i ? "sel" : "")">@curve.Labels[i]</span>
                    }
                  </div>
                </div>
              }
            </div>
            break;

          case LightingCapabilityViewModel lighting:
            <div class="zones">
              @foreach (LightingZoneViewModel zone in lighting.Zones)
              {
                <div class="zone">
                  <span class="caption">@zone.Label</span>
                  <div class="swatches">
                    @foreach (LightingSwatch swatch in zone.Palette)
                    {
                      <button class="swatch @(ReferenceEquals(zone.Selected, swatch) ? "sel" : "")"
                              title="@swatch.Name"
                              style="background:#@swatch.Packed.ToString("X6", CultureInfo.InvariantCulture)"
                              disabled="@(!zone.CanEdit)"
                              @onclick="() => { var z = zone; var s = swatch; OnUi(() => z.Selected = s); }"></button>
                    }
                  </div>
                </div>
              }
            </div>
            break;

          case SlotListCapabilityViewModel slots:
            <div class="slots">
              @foreach (CapabilitySlotViewModel slot in slots.Slots)
              {
                <div class="slot-row">
                  <span class="slot-dot @(slot.IsActive ? "live" : "")"></span>
                  <div class="grow">
                    <div class="cap-title">@slot.Label</div>
                    @if (!string.IsNullOrEmpty(slot.Hint))
                    {
                      <div class="caption wrap">@slot.Hint</div>
                    }
                  </div>
                  @if (slot.IsActive)
                  {
                    <span class="pill transport">@slot.ActiveLabel</span>
                  }
                  else if (slot.ShowsButton)
                  {
                    <button class="outline" disabled="@(!slot.CanEdit)"
                            @onclick="() => { var s = slot; OnUi(() => s.SelectCommand.Execute(null)); }">@slot.Verb</button>
                  }
                </div>
              }
            </div>
            break;

          case ButtonMapCapabilityViewModel map:
            <div class="button-map">
              @foreach (ButtonAssignmentViewModel button in map.Buttons)
              {
                <div class="map-row">
                  <span class="caption map-label">@button.Label</span>
                  @if (!string.IsNullOrEmpty(button.Hint))
                  {
                    <span class="caption accent">@button.Hint</span>
                  }
                  <div class="grow">
                    <Dropdown Items="@([.. button.Actions.Select(a => a.Label)])"
                              Disabled="@(!button.CanEdit)"
                              SelectedIndex="@(button.Selected is { } chosen ? IndexIn(button.Actions, chosen) : -1)"
                              SelectedIndexChanged="i => { var b = button; OnUi(() => b.Selected = b.Actions.ElementAtOrDefault(i)); }" />
                  </div>
                </div>
              }
            </div>
            break;

          case KeyMapCapabilityViewModel keymap:
            <div class="keymap">
              <div class="segmented">
                @foreach (KeyLayer layer in keymap.Layers)
                {
                  <button class="@(ReferenceEquals(keymap.ActiveLayer, layer) ? "sel" : "")"
                          @onclick="() => { var l = layer; OnUi(() => keymap.ActiveLayer = l); }">@layer.Label</button>
                }
              </div>
              @if (keymap.HasLayout)
              {
                <div class="keys" style="grid-template-columns:repeat(@keymap.Columns, 1fr)">
                  @foreach (KeyCapViewModel key in keymap.Keys)
                  {
                    <button class="keycap @(key.IsSelected ? "sel" : "") @(key.IsUnread ? "unread" : "")"
                            title="@key.Position"
                            @onclick="() => { var k = key; OnUi(() => keymap.SelectedKey = k); }">@key.Legend</button>
                  }
                </div>
                @if (keymap.HasSelection)
                {
                  <Dropdown Items="@([.. keymap.Keycodes.Select(k => k.Label)])"
                            Width="200"
                            SelectedIndex="@(keymap.Assignment is { } a ? IndexIn(keymap.Keycodes, a) : -1)"
                            SelectedIndexChanged="i => OnUi(() => keymap.Assignment = keymap.Keycodes.ElementAtOrDefault(i))" />
                }
              }
              else
              {
                <div class="caption">@T.Say("The layer has not been read yet")</div>
              }
            </div>
            break;

          default:
            <span class="value">—</span>
            break;
        }

        @* The amber "not verified" is said by the title badge. The irreversibility
           triangle that used to sit here is gone: see CapabilityViewModel.IsIrreversible
           for what it meant and why it no longer shows. *@
      </div>

      @* Warnings and errors keep a line of their own; everything an inline badge already
         states (untested, read-only, waiting) does not repeat itself here. *@
      @if (!string.IsNullOrEmpty(Vm.Hint) && Vm.HintTone is HintKind.Warning or HintKind.Error)
      {
        <div class="hint tone-@Vm.HintTone.ToString().ToLowerInvariant()">@Vm.Hint</div>
      }
    }
  </div>
</div>

@code {
  /// <summary>
  /// A slot's caption, tagged by where its curve comes from. The wearer's own four sit
  /// beside six the headset ships with, they are edited and deleted quite differently,
  /// and the numbers alone do not say which is which.
  /// </summary>
  private ElementReference _nameField;
  private bool _focusedName;

  /// <summary>
  /// Puts the caret in the name field as the dialog opens.
  ///
  /// Not the autofocus attribute: the browser honours that for elements present when the
  /// document loads, and this one is inserted long afterwards. A dialog whose only field
  /// has to be clicked before it can be typed into is a dialog that has wasted the click
  /// that opened it.
  /// </summary>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    bool naming = Vm is CurveCapabilityViewModel { IsNaming: true };

    if (!naming) { _focusedName = false; return; }
    if (_focusedName) return;

    _focusedName = true;
    await _nameField.FocusAsync();
  }

  /// <summary>
  /// Enter saves, Escape gives up. A method rather than a lambda in the attribute: a
  /// razor attribute is delimited by double quotes and the key names are strings, and
  /// those two facts cannot both hold on one line.
  /// </summary>
  private static void NameKey(CurveCapabilityViewModel curve, KeyboardEventArgs e)
  {
    if (e.Key == "Enter") curve.ConfirmSaveCommand.Execute(null);
    else if (e.Key == "Escape") curve.CancelSaveCommand.Execute(null);
  }

  /// <summary>
  /// Where the curve came from, said in the row rather than in a separate list. "Audeze"
  /// is one the headset ships with; "mine" is one saved here, and the distinction matters
  /// because only the second can be deleted and only the first survives this application
  /// being uninstalled.
  /// </summary>
  private static string PresetLabel(CurvePresetOption option) =>
      $"{option.Label}  ·  {(option.IsSaved ? T["curve.preset.mine", "mine"] : T["curve.preset.vendor", "Audeze"])}";


  [Parameter, EditorRequired] public CapabilityViewModel Vm { get; set; } = default!;

  /// <summary>
  /// Draws this row as a continuation of the one above rather than a thing of its own:
  /// no rule between them and the gap closed up. The left and right channels are one
  /// control the device happens to expose as two.
  /// </summary>
  [Parameter] public bool Joined { get; set; }

  private CapabilityViewModel? _tracked;

  protected override void OnParametersSet()
  {
    if (ReferenceEquals(_tracked, Vm)) return;

    _tracked = Vm;
    Track(Vm);

    switch (Vm)
    {
      case RangeGroupCapabilityViewModel grouped:
        foreach (GroupedRangeViewModel channel in grouped.Channels) Track(channel);
        break;
      case LightingCapabilityViewModel lighting:
        foreach (LightingZoneViewModel zone in lighting.Zones) Track(zone);
        break;
      case ButtonMapCapabilityViewModel map:
        foreach (ButtonAssignmentViewModel button in map.Buttons) Track(button);
        break;
      case KeyMapCapabilityViewModel keymap:
        foreach (KeyCapViewModel key in keymap.Keys) Track(key);
        break;
      case SlotListCapabilityViewModel slots:
        foreach (CapabilitySlotViewModel slot in slots.Slots) Track(slot);
        break;
    }
  }

  private bool Wide => Vm.IsWide;

  /// <summary>A volume/level slider gets the small speaker glyph the audio rows draw.</summary>
  private bool IsAudio => Vm.Domain is CapabilityDomain.Audio or CapabilityDomain.Microphone or CapabilityDomain.Mix;

  private static string BadgeClass(CapabilityBadgeKind kind) => kind switch
  {
    CapabilityBadgeKind.Untested => "untested",
    CapabilityBadgeKind.ReadOnly => "readonly",
    CapabilityBadgeKind.Pending => "pending",
    CapabilityBadgeKind.Accent => "accent",
    CapabilityBadgeKind.Error => "error",
    _ => "",
  };

  private static int IndexIn(IReadOnlyList<CapabilityChoice> options, CapabilityChoice item)
  {
    for (int i = 0; i < options.Count; i++)
    {
      if (ReferenceEquals(options[i], item)) return i;
    }

    return -1;
  }

  private static string Inv(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);

  private static double Parse(ChangeEventArgs e) =>
      double.TryParse((string?)e.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double v) ? v : 0;

  private static string Fill(double value, double min, double max) =>
      max > min ? ((value - min) / (max - min) * 100).ToString("0.#", CultureInfo.InvariantCulture) : "0";

  private static string Pct(double fraction) =>
      (Math.Clamp(fraction, 0, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";

  private static int Percent(double fraction) => (int)Math.Round(Math.Clamp(fraction, 0, 1) * 100);

  /// <summary>
  /// Green until the level is loud, amber where a recording starts to be at risk, red at
  /// the top of the scale. Three colours rather than one because that is what the meter
  /// is for: a level nobody can act on is just an animation.
  /// </summary>
  private static string MeterTone(double fraction) => fraction switch
  {
      >= 0.98 => "hot",
      >= 0.9 => "loud",
      _ => "",
  };

  /// <summary>
  /// The plot's own height in pixels, which the pointer maths needs and CSS owns. Kept
  /// as a constant on both sides rather than measured through interop: a band editor
  /// that has to call into JavaScript to find out how tall it is would pay a round trip
  /// on every pixel of a drag.
  /// </summary>
  private const double PlotHeight = 210;

  /// <summary>
  /// Turns a pointer inside a band column into a value. Reading from the bottom, because
  /// that is the direction the bars grow and the direction the axis counts.
  /// </summary>
  private void Move(CurveCapabilityViewModel curve, int band, PointerEventArgs e) => OnUi(() =>
  {
    curve.SelectedBand = band;

    if (!curve.CanEdit) return;

    double fraction = 1 - (e.OffsetY / PlotHeight);
    curve.MovePointCommand.Execute(new CurvePoint(band, Math.Clamp(fraction, 0, 1)));
  });
}
