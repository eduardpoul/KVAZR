@namespace Maxwell.App.Web
@using System.Globalization

@* The larger battery glyph a device hero draws (artboards 14a–15h): a filled cell with a
   terminal nub, green above the low mark and amber below, a bolt laid over it while it
   charges. The absent variant — a struck, dashed shell — is a different statement from a
   flat one, and stands where a class has a battery this link will not report. *@

@if (Absent)
{
  <svg class="hero-gauge" width="30" height="17" viewBox="0 0 30 17" fill="none">
    <rect x="1" y="2.2" width="23" height="12.6" rx="3.2" stroke="var(--gauge-empty)"
          stroke-width="1.5" stroke-dasharray="3 2.4" />
    <path d="M6.5 8.5h11" stroke="var(--gauge-empty)" stroke-width="1.6" stroke-linecap="round" />
    <path d="M26.4 6.4v4.2" stroke="var(--gauge-empty)" stroke-width="2.4" stroke-linecap="round" />
  </svg>
}
else
{
  <svg class="hero-gauge" width="30" height="17" viewBox="0 0 30 17" fill="none">
    <rect x="1" y="2.2" width="23" height="12.6" rx="3.2" stroke="var(--gauge-shell)" stroke-width="1.5" />
    <rect x="3.2" y="4.4" width="@Fill" height="8.2" rx="1.6" fill="@Colour" />
    <path d="M26.4 6.4v4.2" stroke="var(--gauge-shell)" stroke-width="2.4" stroke-linecap="round" />
    @if (Charging)
    {
      <path d="M14.6 3.4 10.4 9.2h3l-1.4 4.4L16.4 7.6h-3z" fill="#FFFFFF" stroke="rgba(0,0,0,0.35)" stroke-width="0.7" />
    }
  </svg>
}

@code {
  /// <summary>The struck, dashed shell. When set, the fill parameters are ignored.</summary>
  [Parameter] public bool Absent { get; set; }

  /// <summary>0..1 of the cell that is filled.</summary>
  [Parameter] public double Fraction { get; set; }

  [Parameter] public bool Charging { get; set; }

  /// <summary>Below this the fill turns amber, as the dashboard gauge does.</summary>
  [Parameter] public double LowFraction { get; set; } = 0.2;

  private string Fill => (20.6 * Math.Clamp(Fraction, 0, 1)).ToString("0.##", CultureInfo.InvariantCulture);

  private string Colour => Fraction <= LowFraction ? "var(--warning)" : "var(--success)";
}
