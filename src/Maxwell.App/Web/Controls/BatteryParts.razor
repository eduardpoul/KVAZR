@namespace Maxwell.App.Web
@using Maxwell.App.ViewModels.Devices

@* The halves of a device that has more than one battery: the name of the half, its gauge,
   its percentage. The way a pair of earphones is actually read — which one is about to run
   out, and whether the case can still refill it — and the reason the three of them are not
   three rows of a page saying one thing each.

   The three parts are laid out by the grid outside them rather than each row minding its
   own, which is what makes the names, the gauges and the numbers line up in columns
   however long the words are. Hence display:contents on the wrapper. *@

<div class="batt-parts @(Compact ? "compact" : "")">
  @foreach (BatteryPart part in Parts)
  {
    <span class="batt-part">
      <span class="batt-part-name">@part.Label</span>
      <Battery Percent="part.Percent" Charging="part.Charging" />
      <span class="batt-part-value">@part.Percent%</span>
    </span>
  }
</div>

@code {
  [Parameter, EditorRequired] public IReadOnlyList<BatteryPart> Parts { get; set; } = [];

  /// <summary>The list's version: the same columns, a size smaller, to sit inside a card.</summary>
  [Parameter] public bool Compact { get; set; }
}
