@namespace Maxwell.App.Web
@inherits ReactiveComponent

@* Artboard 7b: the mark, the version, the firmware of whatever is attached, the
   credits — and the line at the foot saying this project is not connected to the
   companies whose devices it names. *@

<div class="content narrow">

  <div class="titlebar"><div class="title">@Vm.Title</div></div>

  <div class="about-hero">
    <div class="about-mark">
      <svg width="44" height="44" viewBox="0 0 48 48">
        <circle cx="24" cy="24" r="9" fill="var(--accent-primary)" />
        <path d="M24 4.5 A19.5 19.5 0 1 1 6.5 15" fill="none"
              stroke="var(--accent-primary)" stroke-width="4.4" stroke-linecap="round" />
      </svg>
    </div>
    <div>
      <div class="about-name">@Vm.Name</div>
      <div class="caption">@Vm.Version</div>
    </div>
  </div>

  @if (Vm.HasFirmware)
  {
    <div class="group">
      <div class="group-heading">@T.Say("DEVICE FIRMWARE")</div>
      <div class="card">
        @foreach (FirmwareRow row in Vm.Firmware)
        {
          <div class="set-row">
            <div class="cap-title grow">@row.Device</div>
            <span class="value">@row.Version</span>
            @if (row.HasChecked)
            {
              <span class="caption">@row.Checked</span>
            }
          </div>
        }
      </div>
    </div>
  }

  <div class="group">
    <div class="group-heading">@T.Say("PROJECT")</div>
    <div class="card">
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T.Say("Device protocol")</div>
          <div class="caption wrap">@T.Say("Audeze's RACE was reverse-engineered here. VIA and HID++ compatibility follows the published protocol descriptions")</div>
        </div>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T.Say("Device images")</div>
          <div class="caption wrap">@T.Say("Makers' product shots, brought to a common look. Where each came from is recorded in Assets/Devices/images.json")</div>
        </div>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T.Say("Devices with no catalogue entry")</div>
          <div class="caption wrap">@T.Say("Shown with what the system knows about them: name, class, connection and charge, if the device reports one")</div>
        </div>
      </div>
    </div>
  </div>

  <div class="caption wrap disclaimer">@Vm.Disclaimer</div>
</div>

@code {
  [Parameter, EditorRequired] public AboutViewModel Vm { get; set; } = default!;

  protected override void OnInitialized()
  {
    Follow(T);
    Track(Vm);
    Track(Vm.Firmware);
  }
}
