@namespace Maxwell.App.Web
@inherits ReactiveComponent

@* Artboard 7a, plus the hidden-devices section from 13b. No Apply and no Cancel: a
   switch that has visibly moved but not taken effect is a lie the screen is telling. *@

<div class="content narrow">

  <div class="titlebar"><div class="title">@Vm.Title</div></div>

  <div class="group">
    <div class="group-heading">@T["settings.appearance", "APPEARANCE"]</div>
    <div class="card">
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.theme", "Theme"]</div>
          <div class="caption">@T.Say("System follows the Windows appearance")</div>
        </div>
        <div class="segmented">
          @foreach ((string label, int index) in new[]
          {
            (T["settings.theme.system", "System"], 0),
            (T["settings.theme.light", "Light"], 1),
            (T["settings.theme.dark", "Dark"], 2),
          })
          {
            <button class="@(Vm.ThemeIndex == index ? "sel" : "")"
                    @onclick="() => OnUi(() => Vm.ThemeIndex = index)">@label</button>
          }
        </div>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.language", "Language"]</div>
          <div class="caption">@T["settings.language.caption", "Takes effect at once, no restart"]</div>
        </div>
        @* Each language named in itself: "Russian" under an English interface leaves
           somebody who does not read English unable to find the way back. *@
        <Dropdown Items="@Vm.Languages" Width="188"
                  SelectedIndex="@Vm.LanguageIndex"
                  SelectedIndexChanged="i => OnUi(() => Vm.LanguageIndex = i)" />
      </div>
    </div>
  </div>

  <div class="group">
    <div class="group-heading">@T["settings.startup", "STARTUP AND TRAY"]</div>
    <div class="card">
      <div class="set-row">
        <div class="cap-title grow">@T["settings.run_at_login", "Start with Windows"]</div>
        <button class="switch @(Vm.RunAtLogin ? "on" : "")"
                @onclick="() => OnUi(() => Vm.RunAtLogin = !Vm.RunAtLogin)"><span class="knob"></span></button>
      </div>
      <div class="set-row @(Vm.CanStartMinimised ? "" : "inactive")">
        <div class="cap-text">
          <div class="cap-title">@T["settings.start_minimised", "Start straight to the tray"]</div>
          <div class="caption">@(Vm.CanStartMinimised
            ? T["settings.start_minimised.on", "The window stays shut; the tray icon appears"]
            : T["settings.start_minimised.off", "Available once starting with Windows is on"])</div>
        </div>
        <button class="switch @(Vm.StartMinimised ? "on" : "")" disabled="@(!Vm.CanStartMinimised)"
                @onclick="() => OnUi(() => Vm.StartMinimised = !Vm.StartMinimised)"><span class="knob"></span></button>
      </div>
      <div class="set-row">
        <div class="cap-title grow">@T["settings.minimise_on_close", "Closing the window hides it in the tray"]</div>
        <button class="switch @(Vm.MinimiseOnClose ? "on" : "")"
                @onclick="() => OnUi(() => Vm.MinimiseOnClose = !Vm.MinimiseOnClose)"><span class="knob"></span></button>
      </div>
    </div>
  </div>

  <div class="group">
    <div class="group-heading">@T["settings.notifications", "NOTIFICATIONS AND POLLING"]</div>
    <div class="card">
      <div class="set-row">
        <div class="cap-title grow">@T["settings.notify_low", "Warn about a low battery"]</div>
        <button class="switch @(Vm.NotifyLowBattery ? "on" : "")"
                @onclick="() => OnUi(() => Vm.NotifyLowBattery = !Vm.NotifyLowBattery)"><span class="knob"></span></button>
      </div>
      <div class="set-row @(Vm.CanSetThreshold ? "" : "inactive")">
        <div class="cap-text">
          <div class="cap-title">@T["settings.low_threshold", "Low battery threshold"]</div>
          <div class="caption">@T["settings.low_threshold.caption", "Said once per discharge"]</div>
        </div>
        <div class="range slider-fixed">
          <input type="range" min="5" max="50" step="5" value="@Vm.LowBatteryThreshold"
                 style="--fill:@(((Vm.LowBatteryThreshold - 5) * 100.0 / 45).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"
                 @oninput="e => OnUi(() => Vm.LowBatteryThreshold = int.Parse((string)e.Value!, System.Globalization.CultureInfo.InvariantCulture))" />
          <span class="value slider-value">@Vm.LowBatteryLabel</span>
        </div>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.poll", "How often devices are asked"]</div>
          <div class="caption">@T["settings.poll.caption", "More often means a fresher reading and a flatter battery"]</div>
        </div>
        <Dropdown Items="@Vm.PollIntervalLabels" Width="160"
                  SelectedIndex="@Vm.PollIntervalIndex"
                  SelectedIndexChanged="i => OnUi(() => Vm.PollIntervalIndex = i)" />
      </div>
      <div class="set-row">
        <div class="cap-title grow">@T["settings.notify_charged", "Say when charging finishes"]</div>
        <button class="switch @(Vm.NotifyChargeComplete ? "on" : "")"
                @onclick="() => OnUi(() => Vm.NotifyChargeComplete = !Vm.NotifyChargeComplete)"><span class="knob"></span></button>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.firmware", "Check for firmware updates"]</div>
          <div class="caption">@T["settings.firmware.caption", "Weekly, with Audeze. Their application does the flashing, not this one"]</div>
        </div>
        <button class="switch @(Vm.CheckFirmwareUpdates ? "on" : "")"
                @onclick="() => OnUi(() => Vm.CheckFirmwareUpdates = !Vm.CheckFirmwareUpdates)"><span class="knob"></span></button>
      </div>
    </div>
  </div>

  <div class="group">
    <div class="group-heading">@Vm.HiddenHeading</div>
    <div class="card">
      <div class="set-row">
        <div class="caption wrap grow">
          @T.Say("These devices are absent from the dashboard, the tray and the notifications. The Windows pairings are untouched: put one back in the list and its readings resume.")
        </div>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.hide_silent", "Hide devices we cannot name"]</div>
          <div class="caption">@T.Say("No class and no readings — usually system nodes rather than hardware")</div>
        </div>
        <button class="switch @(Vm.HideSilentDevices ? "on" : "")"
                @onclick="() => OnUi(() => Vm.HideSilentDevices = !Vm.HideSilentDevices)"><span class="knob"></span></button>
      </div>
      @if (Vm.HasHidden)
      {
        @foreach (HiddenDeviceViewModel hidden in Vm.Hidden)
        {
          <div class="set-row">
            <div class="cap-text">
              <div class="cap-title">@hidden.DisplayName</div>
              <div class="caption">@hidden.Kind · @hidden.When</div>
            </div>
            <button class="outline" @onclick="() => { var h = hidden; OnUi(() => h.RestoreCommand.Execute(null)); }">@T.Say("Restore")</button>
          </div>
        }
      }
      else
      {
        <div class="set-row"><div class="caption">@T.Say("Nothing is hidden.")</div></div>
      }
    </div>
  </div>
</div>

@code {
  [Parameter, EditorRequired] public SettingsViewModel Vm { get; set; } = default!;

  protected override void OnInitialized()
  {
    Track(Vm);
    Track(Vm.Hidden);
    Follow(Vm.Text);
  }
}
