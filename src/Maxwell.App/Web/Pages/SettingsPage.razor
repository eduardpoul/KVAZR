@namespace Maxwell.App.Web
@inherits ReactiveComponent

@* Artboard 7a, plus the hidden-devices section from 13b. No Apply and no Cancel: a
   switch that has visibly moved but not taken effect is a lie the screen is telling. *@

<div class="content narrow">

  <div class="titlebar"><div class="title">@Vm.Title</div></div>

  <div class="group">
    <div class="group-heading">@T["settings.appearance", "ВНЕШНИЙ ВИД"]</div>
    <div class="card">
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.theme", "Тема"]</div>
          <div class="caption">Системная следует за оформлением Windows</div>
        </div>
        <div class="segmented">
          @foreach ((string label, int index) in new[]
          {
            (T["settings.theme.system", "Системная"], 0),
            (T["settings.theme.light", "Светлая"], 1),
            (T["settings.theme.dark", "Тёмная"], 2),
          })
          {
            <button class="@(Vm.ThemeIndex == index ? "sel" : "")"
                    @onclick="() => OnUi(() => Vm.ThemeIndex = index)">@label</button>
          }
        </div>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.language", "Язык"]</div>
          <div class="caption">@T["settings.language.caption", "Меняется сразу, без перезапуска"]</div>
        </div>
        @* Each language named in itself: "Russian" under an English interface leaves
           somebody who does not read English unable to find the way back. *@
        <Dropdown Items="@Vm.Languages" Width="188"
                  SelectedIndex="@Vm.LanguageIndex"
                  SelectedIndexChanged="i => OnUi(() => Vm.LanguageIndex = i)" />
      </div>
    </div>
  </div>

  <div class="group">
    <div class="group-heading">@T["settings.startup", "ЗАПУСК И ТРЕЙ"]</div>
    <div class="card">
      <div class="set-row">
        <div class="cap-title grow">@T["settings.run_at_login", "Запускать при входе в Windows"]</div>
        <button class="switch @(Vm.RunAtLogin ? "on" : "")"
                @onclick="() => OnUi(() => Vm.RunAtLogin = !Vm.RunAtLogin)"><span class="knob"></span></button>
      </div>
      <div class="set-row @(Vm.CanStartMinimised ? "" : "inactive")">
        <div class="cap-text">
          <div class="cap-title">@T["settings.start_minimised", "Запускать сразу в трее"]</div>
          <div class="caption">@(Vm.CanStartMinimised
            ? T["settings.start_minimised.on", "Окно не откроется, значок появится в трее"]
            : T["settings.start_minimised.off", "Доступно, когда включён запуск при входе"])</div>
        </div>
        <button class="switch @(Vm.StartMinimised ? "on" : "")" disabled="@(!Vm.CanStartMinimised)"
                @onclick="() => OnUi(() => Vm.StartMinimised = !Vm.StartMinimised)"><span class="knob"></span></button>
      </div>
      <div class="set-row">
        <div class="cap-title grow">@T["settings.minimise_on_close", "Закрытие окна свёртывает в трей"]</div>
        <button class="switch @(Vm.MinimiseOnClose ? "on" : "")"
                @onclick="() => OnUi(() => Vm.MinimiseOnClose = !Vm.MinimiseOnClose)"><span class="knob"></span></button>
      </div>
    </div>
  </div>

  <div class="group">
    <div class="group-heading">@T["settings.notifications", "УВЕДОМЛЕНИЯ И ОПРОС"]</div>
    <div class="card">
      <div class="set-row">
        <div class="cap-title grow">@T["settings.notify_low", "Предупреждать о низком заряде"]</div>
        <button class="switch @(Vm.NotifyLowBattery ? "on" : "")"
                @onclick="() => OnUi(() => Vm.NotifyLowBattery = !Vm.NotifyLowBattery)"><span class="knob"></span></button>
      </div>
      <div class="set-row @(Vm.CanSetThreshold ? "" : "inactive")">
        <div class="cap-text">
          <div class="cap-title">@T["settings.low_threshold", "Порог низкого заряда"]</div>
          <div class="caption">@T["settings.low_threshold.caption", "Уведомление показывается один раз на разряд"]</div>
        </div>
        <div class="range slider-fixed">
          <input type="range" min="5" max="50" step="5" value="@Vm.LowBatteryThreshold"
                 style="--fill:@(((Vm.LowBatteryThreshold - 5) * 100.0 / 45).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"
                 @oninput="e => OnUi(() => Vm.LowBatteryThreshold = int.Parse((string)e.Value!, System.Globalization.CultureInfo.InvariantCulture))" />
          <span class="value slider-value">@Vm.LowBatteryLabel</span>
        </div>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.poll", "Частота опроса устройств"]</div>
          <div class="caption">@T["settings.poll.caption", "Чаще — точнее заряд, выше расход батареи устройства"]</div>
        </div>
        <Dropdown Items="@Vm.PollIntervalLabels" Width="160"
                  SelectedIndex="@Vm.PollIntervalIndex"
                  SelectedIndexChanged="i => OnUi(() => Vm.PollIntervalIndex = i)" />
      </div>
      <div class="set-row">
        <div class="cap-title grow">@T["settings.notify_charged", "Сообщать о полной зарядке"]</div>
        <button class="switch @(Vm.NotifyChargeComplete ? "on" : "")"
                @onclick="() => OnUi(() => Vm.NotifyChargeComplete = !Vm.NotifyChargeComplete)"><span class="knob"></span></button>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.firmware", "Проверять обновления прошивки"]</div>
          <div class="caption">@T["settings.firmware.caption", "Раз в неделю, у Audeze. Прошивает их приложение, не это"]</div>
        </div>
        <button class="switch @(Vm.CheckFirmwareUpdates ? "on" : "")"
                @onclick="() => OnUi(() => Vm.CheckFirmwareUpdates = !Vm.CheckFirmwareUpdates)"><span class="knob"></span></button>
      </div>
    </div>
  </div>

  <div class="group">
    <div class="group-heading">@Vm.HiddenHeading</div>
    <div class="card">
      <div class="set-row">
        <div class="caption wrap grow">
          Эти устройства не показываются на дашборде, в трее и в уведомлениях. Пары в
          Windows не тронуты: вернёте в список — данные снова начнут читаться.
        </div>
      </div>
      <div class="set-row">
        <div class="cap-text">
          <div class="cap-title">@T["settings.hide_silent", "Скрывать непонятные устройства"]</div>
          <div class="caption">Без класса и без данных — обычно служебные узлы, а не техника</div>
        </div>
        <button class="switch @(Vm.HideSilentDevices ? "on" : "")"
                @onclick="() => OnUi(() => Vm.HideSilentDevices = !Vm.HideSilentDevices)"><span class="knob"></span></button>
      </div>
      @if (Vm.HasHidden)
      {
        @foreach (HiddenDeviceViewModel hidden in Vm.Hidden)
        {
          <div class="set-row">
            <div class="cap-text">
              <div class="cap-title">@hidden.DisplayName</div>
              <div class="caption">@hidden.Kind · @hidden.When</div>
            </div>
            <button class="outline" @onclick="() => { var h = hidden; OnUi(() => h.RestoreCommand.Execute(null)); }">Вернуть</button>
          </div>
        }
      }
      else
      {
        <div class="set-row"><div class="caption">Ничего не скрыто.</div></div>
      }
    </div>
  </div>
</div>

@code {
  /// <summary>The catalogue, short enough to sit inside markup.</summary>
  private Maxwell.App.Localization.Localizer T => Vm.Text;

  [Parameter, EditorRequired] public SettingsViewModel Vm { get; set; } = default!;

  protected override void OnInitialized()
  {
    Track(Vm);
    Track(Vm.Hidden);
    Follow(Vm.Text);
  }
}
