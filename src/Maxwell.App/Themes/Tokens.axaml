<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Design tokens for Maxwell.App.

    The Light values are lifted verbatim from the Claude Design canvas
    (Design/audeze-maxwell/project/Maxwell Hub.dc.html) — they are not approximations.

    The Dark values are DERIVED. The canvas only ever produced a dark variant for the
    intermediate dashboard, never for the final screens, so this palette follows Fluent
    conventions rather than a mock-up. It needs a look before it spreads across every
    screen; see docs/PLAN.md risk 1.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="AccentPrimaryColor">#0F6CBD</Color>
      <Color x:Key="AccentHoverColor">#0C5AA6</Color>
      <Color x:Key="AccentSubtleColor">#1A0F6CBD</Color>
      <Color x:Key="AccentBorderColor">#590F6CBD</Color>

      <Color x:Key="TextPrimaryColor">#1B1B1B</Color>
      <Color x:Key="TextSecondaryColor">#616161</Color>
      <Color x:Key="TextTertiaryColor">#8A8A8A</Color>
      <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

      <Color x:Key="LayerBackgroundColor">#F3F3F3</Color>
      <Color x:Key="LayerCardColor">#FFFFFF</Color>
      <Color x:Key="LayerSubtleColor">#F9F9F9</Color>
      <Color x:Key="LayerAltColor">#F5F5F5</Color>
      <Color x:Key="LayerSelectedColor">#EBEBEB</Color>
      <Color x:Key="LayerHoverColor">#0A000000</Color>

      <Color x:Key="StrokeDefaultColor">#1A000000</Color>
      <Color x:Key="StrokeSubtleColor">#0F000000</Color>
      <Color x:Key="StrokeStrongColor">#73000000</Color>

      <Color x:Key="DangerColor">#C42B1C</Color>
      <Color x:Key="WarningColor">#986F0B</Color>
      <Color x:Key="SuccessColor">#0F7B0F</Color>

      <!-- Capability state markers, from artboard 2a. Untested is the amber dot that
           disappears after the first accepted write; Irreversible is the triangle shown
           before a write that cannot be undone. -->
      <Color x:Key="StatusUntestedColor">#EAA300</Color>
      <Color x:Key="NoticeFillColor">#14EAA300</Color>
      <Color x:Key="NoticeStrokeColor">#4DEAA300</Color>
      <Color x:Key="StatusIrreversibleColor">#9D5D00</Color>
      <Color x:Key="StatusPendingColor">#8C0F6CBD</Color>
      <Color x:Key="StatusExternalRingColor">#380F6CBD</Color>
      <Color x:Key="StatusErrorBorderColor">#8CC42B1C</Color>

      <!-- The tray panel, Turn 12: a translucent sheet over whatever sits behind it, and
           the flat colour it falls back to wherever the compositor gives us no blur. -->
      <Color x:Key="FlyoutTintColor">#F9F9F9</Color>
      <Color x:Key="FlyoutStrokeColor">#14000000</Color>
      <Color x:Key="FlyoutFadeStartColor">#00F9F9F9</Color>
      <Color x:Key="FlyoutFadeEndColor">#F0F9F9F9</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="AccentPrimaryColor">#479EF5</Color>
      <Color x:Key="AccentHoverColor">#62ABF5</Color>
      <Color x:Key="AccentSubtleColor">#26479EF5</Color>
      <Color x:Key="AccentBorderColor">#59479EF5</Color>

      <Color x:Key="TextPrimaryColor">#E8E8E8</Color>
      <Color x:Key="TextSecondaryColor">#A0A0A0</Color>
      <Color x:Key="TextTertiaryColor">#8A8A8A</Color>
      <Color x:Key="TextOnAccentColor">#000000</Color>

      <Color x:Key="LayerBackgroundColor">#202020</Color>
      <Color x:Key="LayerCardColor">#2D2D2D</Color>
      <Color x:Key="LayerSubtleColor">#0AFFFFFF</Color>
      <Color x:Key="LayerAltColor">#12FFFFFF</Color>
      <Color x:Key="LayerSelectedColor">#1CFFFFFF</Color>
      <Color x:Key="LayerHoverColor">#0DFFFFFF</Color>

      <Color x:Key="StrokeDefaultColor">#14FFFFFF</Color>
      <Color x:Key="StrokeSubtleColor">#0DFFFFFF</Color>
      <Color x:Key="StrokeStrongColor">#73FFFFFF</Color>

      <Color x:Key="DangerColor">#FF99A4</Color>
      <Color x:Key="WarningColor">#FCE100</Color>
      <Color x:Key="SuccessColor">#6CCB5F</Color>

      <Color x:Key="StatusUntestedColor">#FFCB4D</Color>
      <Color x:Key="NoticeFillColor">#1FFFCB4D</Color>
      <Color x:Key="NoticeStrokeColor">#4DFFCB4D</Color>
      <Color x:Key="StatusIrreversibleColor">#E9A825</Color>
      <Color x:Key="StatusPendingColor">#8C479EF5</Color>
      <Color x:Key="StatusExternalRingColor">#38479EF5</Color>
      <Color x:Key="StatusErrorBorderColor">#8CFF99A4</Color>

      <Color x:Key="FlyoutTintColor">#2C2C2C</Color>
      <Color x:Key="FlyoutStrokeColor">#17FFFFFF</Color>
      <Color x:Key="FlyoutFadeStartColor">#002C2C2C</Color>
      <Color x:Key="FlyoutFadeEndColor">#EB2C2C2C</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Brushes resolve against whichever theme dictionary is active. -->
  <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{DynamicResource AccentPrimaryColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="{DynamicResource AccentSubtleColor}" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="{DynamicResource AccentBorderColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource TextOnAccentColor}" />

  <SolidColorBrush x:Key="LayerBackgroundBrush" Color="{DynamicResource LayerBackgroundColor}" />
  <SolidColorBrush x:Key="LayerCardBrush" Color="{DynamicResource LayerCardColor}" />
  <SolidColorBrush x:Key="LayerSubtleBrush" Color="{DynamicResource LayerSubtleColor}" />
  <SolidColorBrush x:Key="LayerAltBrush" Color="{DynamicResource LayerAltColor}" />
  <SolidColorBrush x:Key="LayerSelectedBrush" Color="{DynamicResource LayerSelectedColor}" />
  <SolidColorBrush x:Key="LayerHoverBrush" Color="{DynamicResource LayerHoverColor}" />

  <SolidColorBrush x:Key="StrokeDefaultBrush" Color="{DynamicResource StrokeDefaultColor}" />
  <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{DynamicResource StrokeSubtleColor}" />
  <SolidColorBrush x:Key="StrokeStrongBrush" Color="{DynamicResource StrokeStrongColor}" />

  <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="{DynamicResource FlyoutStrokeColor}" />

  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />

  <SolidColorBrush x:Key="StatusUntestedBrush" Color="{DynamicResource StatusUntestedColor}" />

  <!-- The notice card of artboard 11c: the same amber as an untested capability, because
       it says the same kind of thing — this is what we do not know yet. -->
  <SolidColorBrush x:Key="NoticeFillBrush" Color="{DynamicResource NoticeFillColor}" />
  <SolidColorBrush x:Key="NoticeStrokeBrush" Color="{DynamicResource NoticeStrokeColor}" />
  <SolidColorBrush x:Key="StatusIrreversibleBrush" Color="{DynamicResource StatusIrreversibleColor}" />
  <SolidColorBrush x:Key="StatusPendingBrush" Color="{DynamicResource StatusPendingColor}" />
  <SolidColorBrush x:Key="StatusExternalRingBrush" Color="{DynamicResource StatusExternalRingColor}" />
  <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="{DynamicResource StatusErrorBorderColor}" />

  <!-- Geometry and type scale, both taken from the canvas. -->
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">10</CornerRadius>

  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeSecondary">13</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeSubtitle">20</x:Double>
  <x:Double x:Key="FontSizeTitle">28</x:Double>
  <x:Double x:Key="FontSizeDisplay">34</x:Double>

</ResourceDictionary>
