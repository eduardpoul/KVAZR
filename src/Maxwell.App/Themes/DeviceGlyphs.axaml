<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    What a device looks like when we have no photograph of it, which is most devices and
    always will be. Drawn as outlines on a 24 x 24 grid at the same weight as the icons
    in the rest of the interface, so a list of them reads as one set rather than as a
    gap where pictures were meant to go.

    Stroked rather than filled deliberately: a filled silhouette next to a photographed
    device looks like a placeholder, while an outline at the same weight as the interface
    around it looks like part of the design. At the size these are actually used — under
    forty pixels in a device row — an outline is also simply more legible.

    Every device class has one, including Unknown. A device that tells us nothing still
    gets a row, and an empty tile there reads as a rendering fault rather than as a
    device nobody has identified.

    Each has to be recognisable at sixteen pixels in the navigation pane and again at
    ninety-six in a device's hero, which rules out the obvious shortcuts. Earbuds cannot
    be two circles on sticks — at any size that is two lollipops. A mouse cannot be a
    rounded rectangle, because so is a remote, a card and a pill. So each shape carries
    the one detail that separates it from its neighbours here: the boom on the headset,
    the stem on the earbud, the wheel and seam on the mouse, the drivers on the speaker,
    the grips on the gamepad, the contacts on the dongle.
  -->

  <!-- Over-ear, with the boom. The boom is what tells it from the earbuds below. -->
  <StreamGeometry x:Key="GlyphHeadset">
    M4 14v-3a8 8 0 0 1 16 0v3
    M2.6 14.6a2 2 0 0 1 2-2h1a1.5 1.5 0 0 1 1.5 1.5v4.8a1.5 1.5 0 0 1-1.5 1.5h-1a2 2 0 0 1-2-2z
    M21.4 14.6a2 2 0 0 0-2-2h-1a1.5 1.5 0 0 0-1.5 1.5v4.8a1.5 1.5 0 0 0 1.5 1.5h1a2 2 0 0 0 2-2z
    M17.4 20.4v.4a2.2 2.2 0 0 1-2.2 2.2h-2.6
  </StreamGeometry>

  <!-- Bulb and stem, twice. The stem is the whole difference from a pair of dots. -->
  <StreamGeometry x:Key="GlyphEarbuds">
    M7.4 3.4a2.8 2.8 0 0 1 2.8 2.8v3a2.8 2.8 0 0 1-5.6 0v-3a2.8 2.8 0 0 1 2.8-2.8z
    M6.2 9.6v8.6a1.2 1.2 0 0 0 2.4 0V9.6
    M16.6 3.4a2.8 2.8 0 0 1 2.8 2.8v3a2.8 2.8 0 0 1-5.6 0v-3a2.8 2.8 0 0 1 2.8-2.8z
    M15.4 9.6v8.6a1.2 1.2 0 0 0 2.4 0V9.6
  </StreamGeometry>

  <StreamGeometry x:Key="GlyphMicrophone">
    M12 3.2a3.2 3.2 0 0 1 3.2 3.2v5.4a3.2 3.2 0 0 1-6.4 0V6.4A3.2 3.2 0 0 1 12 3.2z
    M6.8 11v1.2a5.2 5.2 0 0 0 10.4 0V11
    M12 17.4v3.2
    M8.8 20.6h6.4
  </StreamGeometry>

  <!-- Cabinet with a woofer and a tweeter: two drivers are what make it a speaker
       rather than a phone. -->
  <StreamGeometry x:Key="GlyphSpeaker">
    M6.6 2.6h10.8a1.8 1.8 0 0 1 1.8 1.8v15.2a1.8 1.8 0 0 1-1.8 1.8H6.6a1.8 1.8 0 0 1-1.8-1.8V4.4a1.8 1.8 0 0 1 1.8-1.8z
    M12 12.6a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2z
    M12 5.8a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8z
  </StreamGeometry>

  <!-- The wheel and the seam. Without them this outline is a pill. -->
  <StreamGeometry x:Key="GlyphMouse">
    M12 2.6a6.6 6.6 0 0 1 6.6 6.6v5.6a6.6 6.6 0 0 1-13.2 0V9.2A6.6 6.6 0 0 1 12 2.6z
    M12 6.2v3.6
    M5.5 11.6h13
  </StreamGeometry>

  <StreamGeometry x:Key="GlyphKeyboard">
    M3.4 6.8h17.2a1.6 1.6 0 0 1 1.6 1.6v7.2a1.6 1.6 0 0 1-1.6 1.6H3.4a1.6 1.6 0 0 1-1.6-1.6V8.4a1.6 1.6 0 0 1 1.6-1.6z
    M5.6 10.6h.8 M8.6 10.6h.8 M11.6 10.6h.8 M14.6 10.6h.8 M17.6 10.6h.8
    M5.6 13.4h.8 M8.6 13.4h.8 M11.6 13.4h.8 M14.6 13.4h.8 M17.6 13.4h.8
    M8.8 16h6.4
  </StreamGeometry>

  <!-- Two grips, a d-pad and two buttons. The grips are the shape people recognise. -->
  <StreamGeometry x:Key="GlyphGamepad">
    M8.6 7.8h6.8a5.8 5.8 0 0 1 5.7 4.7l.6 3.2a2.9 2.9 0 0 1-5.3 2.2l-1.5-2.1H9.1l-1.5 2.1a2.9 2.9 0 0 1-5.3-2.2l.6-3.2a5.8 5.8 0 0 1 5.7-4.7z
    M6.2 12.6h3.2 M7.8 11v3.2
    M15.6 11.8h.01 M17.8 13.8h.01
  </StreamGeometry>

  <!-- A stick with contacts and a signal above it. The contacts say "plugged in". -->
  <StreamGeometry x:Key="GlyphReceiver">
    M9.4 10.2h5.2a1.2 1.2 0 0 1 1.2 1.2v6.2a1.2 1.2 0 0 1-1.2 1.2H9.4a1.2 1.2 0 0 1-1.2-1.2v-6.2a1.2 1.2 0 0 1 1.2-1.2z
    M10.6 18.8v1.8h2.8v-1.8
    M12 10.2V8.2
    M9.2 6.6a4 4 0 0 1 5.6 0
    M7 4.4a7.2 7.2 0 0 1 10 0
  </StreamGeometry>

  <!-- Nothing came back about this one. A rounded plate with a question in it, at the
       weight of the rest of the set: the statement is "not identified", not "error". -->
  <StreamGeometry x:Key="GlyphUnknown">
    M5.8 3.8h12.4a2.2 2.2 0 0 1 2.2 2.2v12a2.2 2.2 0 0 1-2.2 2.2H5.8a2.2 2.2 0 0 1-2.2-2.2V6a2.2 2.2 0 0 1 2.2-2.2z
    M10 10a2.1 2.1 0 0 1 4.1.5c0 1.4-2 1.8-2 3.1
    M12 16.4h.01
  </StreamGeometry>

</ResourceDictionary>
