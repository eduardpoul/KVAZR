<!--
  Размеры, снятые с макета машинно. НЕ ПРАВИТЬ РУКАМИ.

  Сгенерировано tools/design-tokens.py из Design/kvazr/Devices Hub.dc.html.
  Каждое значение взято из конкретного элемента конкретного артборда, а не
  перенесено на глаз: экраны, которые собирали переписыванием чисел, каждый раз
  расходились с макетом в новом месте, и заметно это становилось только когда
  готовый экран клали рядом с артбордом.

  Поменялся дизайн — перезапустить скрипт, а не искать числа по разметке.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- Строка устройства целиком, включая разделитель -->
  <sys:Double x:Key="DashRowHeight">84</sys:Double>
  <!-- Между плиткой и текстом -->
  <sys:Double x:Key="DashRowGap">16</sys:Double>
  <Thickness x:Key="DashRowGapRight">0,0,16,0</Thickness>
  <Thickness x:Key="DashRowPadding">16,0,16,0</Thickness>
  <!-- Плитка изображения -->
  <sys:Double x:Key="DashThumbSize">60</sys:Double>
  <sys:Double x:Key="DashThumbRadius">6</sys:Double>
  <CornerRadius x:Key="DashThumbRadiusCorner">6</CornerRadius>
  <sys:Double x:Key="DashNameSize">15</sys:Double>
  <!-- Между пилюлями под именем -->
  <sys:Double x:Key="DashSubGap">6</sys:Double>
  <Thickness x:Key="DashSubGapRight">0,0,6,0</Thickness>
  <!-- Пилюля класса устройства -->
  <sys:Double x:Key="DashPillSize">11</sys:Double>
  <sys:Double x:Key="DashPillRadius">4</sys:Double>
  <CornerRadius x:Key="DashPillRadiusCorner">4</CornerRadius>
  <Thickness x:Key="DashPillPadding">7,2,7,2</Thickness>
  <!-- Пилюля транспорта — на пиксель уже, потому что у неё есть рамка -->
  <Thickness x:Key="DashTransportPadding">7,1,7,1</Thickness>
  <!-- Заголовок группы, ПОДКЛЮЧЕНЫ · 6 -->
  <sys:Double x:Key="DashGroupSize">12</sys:Double>
  <!-- Заголовок страницы -->
  <sys:Double x:Key="DashTitleSize">28</sys:Double>
  <sys:Double x:Key="FlyoutRowHeight">56</sys:Double>
  <sys:Double x:Key="FlyoutRowGap">12</sys:Double>
  <Thickness x:Key="FlyoutRowGapRight">0,0,12,0</Thickness>
  <Thickness x:Key="FlyoutRowPadding">6,0,6,0</Thickness>
  <sys:Double x:Key="FlyoutRowRadius">4</sys:Double>
  <CornerRadius x:Key="FlyoutRowRadiusCorner">4</CornerRadius>
  <sys:Double x:Key="FlyoutThumbSize">36</sys:Double>
  <sys:Double x:Key="FlyoutThumbRadius">6</sys:Double>
  <CornerRadius x:Key="FlyoutThumbRadiusCorner">6</CornerRadius>
  <sys:Double x:Key="FlyoutNameSize">13</sys:Double>
  <sys:Double x:Key="FlyoutSubSize">11</sys:Double>
  <sys:Double x:Key="FlyoutBatterySize">15</sys:Double>
  <!-- Ровно пять строк; дальше список прокручивается, а панель не растёт -->
  <sys:Double x:Key="FlyoutListHeight">284</sys:Double>
  <sys:Double x:Key="FlyoutWidth">360</sys:Double>
  <sys:Double x:Key="FlyoutRadius">8</sys:Double>
  <CornerRadius x:Key="FlyoutRadiusCorner">8</CornerRadius>
  <Thickness x:Key="FlyoutHeaderPadding">16,14,16,8</Thickness>
  <sys:Double x:Key="FlyoutHeaderSize">13</sys:Double>
  <sys:Double x:Key="FlyoutFooterHeight">44</sys:Double>
  <Thickness x:Key="FlyoutFooterPadding">16,0,16,0</Thickness>
  <sys:Double x:Key="FlyoutFooterSize">12</sys:Double>
  <Thickness x:Key="FlyoutListPadding">10,0,10,0</Thickness>
  <sys:Double x:Key="EmptyTitleSize">32</sys:Double>
  <sys:Double x:Key="EmptyBodySize">15</sys:Double>
  <Thickness x:Key="EmptyCardPadding">18,18,18,18</Thickness>
  <sys:Double x:Key="EmptyCardRadius">8</sys:Double>
  <CornerRadius x:Key="EmptyCardRadiusCorner">8</CornerRadius>
  <sys:Double x:Key="EmptyCardGap">14</sys:Double>
  <Thickness x:Key="EmptyCardGapRight">0,0,14,0</Thickness>
  <sys:Double x:Key="EmptyCardTitleSize">14</sys:Double>
  <sys:Double x:Key="EmptyCardBodySize">12</sys:Double>
  <!-- Глиф класса на карточке, из <svg width> артборда 6c -->
  <sys:Double x:Key="EmptyGlyphSize">34</sys:Double>
  <Thickness x:Key="PagePadding">28,22,28,22</Thickness>
  <sys:Double x:Key="HeroGap">20</sys:Double>
  <Thickness x:Key="HeroGapRight">0,0,20,0</Thickness>
  <sys:Double x:Key="HeroThumbSize">96</sys:Double>
  <sys:Double x:Key="HeroThumbRadius">8</sys:Double>
  <CornerRadius x:Key="HeroThumbRadiusCorner">8</CornerRadius>
  <sys:Double x:Key="HeroNameSize">26</sys:Double>
  <!-- Заряд — самое крупное на странице, потому что за ним и приходят чаще всего -->
  <sys:Double x:Key="HeroBatterySize">44</sys:Double>
  <sys:Double x:Key="SectionHeadingSize">12</sys:Double>
  <sys:Double x:Key="PageRowHeight">64</sys:Double>
  <Thickness x:Key="PageRowPadding">16,0,16,0</Thickness>
  <sys:Double x:Key="PageRowGap">16</sys:Double>
  <Thickness x:Key="PageRowGapRight">0,0,16,0</Thickness>
  <sys:Double x:Key="PageRowTitleSize">14</sys:Double>
  <!-- Колонка контрола: одинаковая на всех строках, иначе значения не выстраиваются -->
  <sys:Double x:Key="PageControlWidth">260</sys:Double>

</ResourceDictionary>
