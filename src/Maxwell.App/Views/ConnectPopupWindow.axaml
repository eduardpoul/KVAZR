<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Maxwell.App.Controls"
        xmlns:conv="using:Maxwell.App.Converters"
        xmlns:devices="using:Maxwell.App.ViewModels.Devices"
        x:Class="Maxwell.App.Views.ConnectPopupWindow"
        x:DataType="devices:DeviceListItemViewModel"
        Width="320" Height="140"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        CornerRadius="8"
        Background="{DynamicResource LayerCardBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="{DynamicResource FontSizeBody}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <!--
    Artboard 3e. Appears when a device connects, says the one thing worth saying, and
    goes away by itself after a few seconds.

    ShowActivated is false and there is nothing to click: an announcement that steals
    the keyboard from whatever the person was typing into is not an announcement, it is
    an interruption.
  -->

  <Window.Resources>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="8">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="18">

      <Border Grid.Column="0" Width="72" Height="72"
              Background="{DynamicResource LayerAltBrush}"
              CornerRadius="{DynamicResource RadiusSmall}"
              ClipToBounds="True"
              Margin="0,0,16,0"
              VerticalAlignment="Center">
        <ctl:DeviceThumb Photo="{Binding Photo}" IconKey="{Binding IconKey}" />
      </Border>

      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
        <TextBlock Classes="cardTitle" Text="{Binding DisplayName}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="caption" Text="{Binding Status}" />
      </StackPanel>

      <TextBlock Grid.Column="2"
                 FontSize="{DynamicResource FontSizeTitle}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Text="{Binding Battery}" />
    </Grid>
  </Border>

</Window>
