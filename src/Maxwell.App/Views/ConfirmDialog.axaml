<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Maxwell.App.Views.ConfirmDialog"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        ShowInTaskbar="False"
        Background="{DynamicResource LayerCardBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="{DynamicResource FontSizeBody}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <!--
    The question asked before anything irreversible. Written from the capability itself
    rather than from a table of strings, so a driver that adds a dangerous command gets
    a truthful question instead of a generic "are you sure" that says nothing.
  -->

  <StackPanel Margin="24" Spacing="16">
    <TextBlock x:Name="TitleText" Classes="sectionTitle" TextWrapping="Wrap" />
    <StackPanel x:Name="Body" Spacing="8" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <!-- Cancel first and focused: the dangerous path is the one that takes a
           deliberate press, not the one Enter lands on. -->
      <Button x:Name="CancelButton" Content="Отмена" Click="OnCancel" IsCancel="True" MinWidth="96" />
      <Button x:Name="ConfirmButton" Classes="danger" Click="OnConfirm" MinWidth="120" />
    </StackPanel>
  </StackPanel>

</Window>
