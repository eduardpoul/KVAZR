<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Maxwell.App.Controls"
             xmlns:pages="using:Maxwell.App.ViewModels.Pages"
             x:Class="Maxwell.App.Views.Pages.IdentityView"
             x:DataType="pages:IdentityViewModel">

  <!--
    Sections 04, 05, 07 and 08 of the identity, in the running application. Not a
    demo screen: it is where a change to the mark gets reviewed, in the theme and at
    the DPI the user has, which is the only place the question can be settled.
  -->

  <StackPanel Spacing="12">

    <!-- 04 · States -->
    <Border Classes="card">
      <StackPanel Spacing="4">
        <TextBlock Classes="cardTitle" Text="Состояния знака" />
        <TextBlock Classes="caption" Margin="0,0,0,8"
                   Text="Они же состояния трея. 32 и 16 px, потому что 16 — это пол, ниже которого знак не ставится." />

        <ItemsControl ItemsSource="{Binding States}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pages:IdentityState">
              <Grid ColumnDefinitions="56,32,*" Height="48">
                <controls:KvazrMarkControl Grid.Column="0" Width="32" Height="32"
                                           State="{Binding State}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <controls:KvazrMarkControl Grid.Column="1" Width="16" Height="16"
                                           State="{Binding State}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Spacing="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="caption" Text="{Binding Hint}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- 05 · Motions -->
    <Border Classes="card">
      <StackPanel Spacing="4">
        <TextBlock Classes="cardTitle" Text="Анимации" />
        <TextBlock Classes="caption" Margin="0,0,0,8"
                   Text="Тайминги заданы точно и не выбираются на месте." />

        <ItemsControl ItemsSource="{Binding Motions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pages:IdentityMotion">
              <Grid ColumnDefinitions="72,*" Height="64">
                <controls:KvazrMarkControl Grid.Column="0" Width="48" Height="48"
                                           Motion="{Binding Motion}"
                                           OrbitShade="Resting"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="caption" Text="{Binding Hint}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- 07 · Loaders -->
    <Border Classes="card">
      <StackPanel Spacing="16">
        <StackPanel Spacing="4">
          <TextBlock Classes="cardTitle" Text="Лоадеры" />
          <TextBlock Classes="caption" Text="Орбита 48 на пустом экране, инлайн 20 в строке, прогресс там, где известен объём." />
        </StackPanel>

        <!-- Orbit 48: an empty screen, first sweep. -->
        <Border Background="{DynamicResource LayerSubtleBrush}"
                CornerRadius="{DynamicResource RadiusCard}"
                Height="180">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
            <controls:KvazrMarkControl Width="48" Height="48"
                                       Motion="Loading" OrbitShade="Resting"
                                       HorizontalAlignment="Center" />
            <StackPanel Spacing="5" HorizontalAlignment="Center">
              <TextBlock Classes="cardTitle" Text="Ищем устройства" HorizontalAlignment="Center" />
              <TextBlock Classes="caption" Text="Проверяем USB и Bluetooth" HorizontalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Inline 20: the row is here, one value is not. -->
        <Grid ColumnDefinitions="Auto,*,Auto" Height="68">
          <Border Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0"
                  Background="{DynamicResource LayerAltBrush}"
                  CornerRadius="{DynamicResource RadiusSmall}" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Classes="cardTitle" Text="Audeze Maxwell" />
            <TextBlock Classes="caption" Text="Наушники · 2,4 ГГц" />
          </StackPanel>
          <controls:KvazrMarkControl Grid.Column="2" Width="20" Height="20"
                                     Motion="Fast" OrbitShade="Resting"
                                     VerticalAlignment="Center" />
        </Grid>

        <!-- Determinate: firmware, where the total is known. -->
        <Grid ColumnDefinitions="Auto,*" Height="76">
          <controls:KvazrMarkControl Grid.Column="0" Width="56" Height="56" Margin="0,0,20,0"
                                     State="FirmwareUpdating"
                                     Progress="{Binding FirmwareProgress}"
                                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="cardTitle" Text="Обновление прошивки" />
            <TextBlock Classes="caption" Text="{Binding FirmwareCaption}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 08 · Skeletons -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="cardTitle" Text="Скелетоны" />
          <TextBlock Classes="caption"
                     Text="Цвет орбиты, скругление в половину высоты, 30→70 % за 1,4 с, соседние блоки со сдвигом по фазе." />
        </StackPanel>

        <!-- Three rows at exactly the height of a real one, phase-shifted across the row. -->
        <ItemsControl>
          <Grid ColumnDefinitions="Auto,*,Auto" Height="68">
            <controls:Skeleton Grid.Column="0" Width="44" Height="44" Radius="6" Margin="0,0,14,0"
                               VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
              <controls:Skeleton Width="180" Height="9" Phase="1" HorizontalAlignment="Left" />
              <controls:Skeleton Width="106" Height="7" Phase="2" HorizontalAlignment="Left" />
            </StackPanel>
            <controls:Skeleton Grid.Column="2" Width="38" Height="9" Phase="3" VerticalAlignment="Center" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto" Height="68">
            <controls:Skeleton Grid.Column="0" Width="44" Height="44" Radius="6" Phase="2" Margin="0,0,14,0"
                               VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
              <controls:Skeleton Width="140" Height="9" Phase="3" HorizontalAlignment="Left" />
              <controls:Skeleton Width="88" Height="7" Phase="4" HorizontalAlignment="Left" />
            </StackPanel>
            <controls:Skeleton Grid.Column="2" Width="38" Height="9" Phase="5" VerticalAlignment="Center" />
          </Grid>
        </ItemsControl>
      </StackPanel>
    </Border>

  </StackPanel>

</UserControl>
