<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Maxwell.App.Controls"
             xmlns:vm="using:Maxwell.App.ViewModels"
             xmlns:devices="using:Maxwell.App.ViewModels.Devices"
             xmlns:conv="using:Maxwell.App.Converters"
             x:Class="Maxwell.App.Views.Pages.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <!--
    Artboard 1a. One row carries image, name, kind, transport, state and battery, and
    nothing else: a list that tries to say everything about six devices says nothing
    about any of them.
  -->

  <UserControl.Resources>
    <conv:PresenceOpacityConverter x:Key="PresenceOpacity" />
  </UserControl.Resources>

  <StackPanel Spacing="12">

    <!-- Empty state, artboard 6c. Not an error — this is what a first launch looks
         like, and it should read as an introduction rather than a failure. -->
    <Border Classes="card" IsVisible="{Binding IsEmpty}">
      <StackPanel Spacing="8" Margin="24">
        <TextBlock Classes="sectionTitle" Text="Устройств пока нет" />
        <TextBlock Classes="secondary" MaxWidth="520"
                   Text="Подключите наушники, мышь или клавиатуру — приложение найдёт их само. Заряд появится в трее, настройки — на странице устройства." />
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Devices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="devices:DeviceListItemViewModel">
          <Border Classes="card" Margin="0,0,0,8" Opacity="{Binding IsPresent, Converter={StaticResource PresenceOpacity}}">

            <!--
              Artboard 13a. Putting a device away is a right-click rather than a control
              on the row: it happens once in the life of a device, and a permanent button
              would sit beside the battery of every device forever for it.
            -->
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Скрыть устройство"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).Shell.HideDeviceCommand}"
                          CommandParameter="{Binding}" />
              </ContextMenu>
            </Border.ContextMenu>

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20">

              <Border Grid.Column="0" Width="52" Height="52"
                      Background="{DynamicResource LayerAltBrush}"
                      CornerRadius="{DynamicResource RadiusSmall}"
                      ClipToBounds="True"
                      Margin="0,0,16,0">
                <ctl:DeviceThumb Photo="{Binding Photo}" Glyph="{Binding Glyph}" />
              </Border>

              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="cardTitle" Text="{Binding DisplayName}" />
                <TextBlock Classes="caption" Text="{Binding Status}" />
              </StackPanel>

              <TextBlock Grid.Column="2"
                         FontSize="{DynamicResource FontSizeSubtitle}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Text="{Binding Battery}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!--
      Hiding without a visible way back is a trap rather than a feature, so the count
      and the way back live on the dashboard itself and not only in the settings screen
      they will eventually also appear in. It is absent entirely when nothing is hidden.
    -->
    <StackPanel Orientation="Horizontal" Spacing="10"
                IsVisible="{Binding Shell.HasHidden}">
      <TextBlock Classes="caption" VerticalAlignment="Center"
                 Text="{Binding Shell.HiddenCount, StringFormat='Скрыто: {0}'}" />
      <Button Content="Показать все"
              Command="{Binding Shell.ShowHiddenCommand}" />
    </StackPanel>

  </StackPanel>

</UserControl>
