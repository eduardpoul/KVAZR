<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Maxwell.App.ViewModels.Pages"
             x:Class="Maxwell.App.Views.Pages.ProfilesView"
             x:DataType="pages:ProfilesViewModel">

  <StackPanel Spacing="12">

    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Профили" />
            <TextBlock Classes="caption"
                       Text="Профиль сохраняет только то, что прочитано с наушников, и применяет только это — остальные настройки не трогает." />
          </StackPanel>
          <Button Grid.Column="1" Content="Снять с текущих"
                  Command="{Binding CaptureCurrentCommand}" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Classes="secondary" Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsEmpty}">
      <StackPanel Spacing="8">
        <TextBlock Classes="cardTitle" Text="Профилей пока нет" />
        <TextBlock Classes="secondary"
                   Text="Настройте звук и микрофон так, как нужно, и нажмите «Снять с текущих» — приложение запомнит всё, что смогло прочитать." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding !IsEmpty}">
      <StackPanel Spacing="10">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="pages:ProfileRow">
              <Grid ColumnDefinitions="*,Auto" MinHeight="64">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBox Text="{Binding Name}" MaxWidth="320" HorizontalAlignment="Left" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="caption" Text="{Binding Summary}" />
                    <TextBlock Classes="caption" Text="·" />
                    <TextBlock Classes="caption" Text="{Binding TriggerText}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                  <Button Content="Применить"
                          Command="{Binding $parent[ItemsControl].((pages:ProfilesViewModel)DataContext).ApplyCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="Удалить"
                          Command="{Binding $parent[ItemsControl].((pages:ProfilesViewModel)DataContext).DeleteCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Classes="divider" />

        <Button Content="Сохранить изменения" Command="{Binding SaveCommand}"
                HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Автопереключение профиля" />
            <TextBlock Classes="caption"
                       Text="По запущенной игре или приложению. Слежение за процессами ещё не реализовано — переключатель сохраняется, но пока ни на что не влияет." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoSwitch}"
                        OnContent="" OffContent="" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
