<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Maxwell.App.ViewModels.Pages"
             x:Class="Maxwell.App.Views.Pages.HotkeysView"
             x:DataType="pages:HotkeysViewModel"
             Focusable="True">

  <!--
    Global shortcuts, one row per action, in the same cards of rows as everything else.

    The page takes focus and listens for keys itself, because a global shortcut is
    captured by pressing it and there is no control that can be asked to report a
    combination — a TextBox would swallow the modifiers and a Button never sees them.
  -->

  <UserControl.Styles>
    <Style Selector="Border.sectionCard">
      <Setter Property="Background" Value="{DynamicResource LayerCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.rule">
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.rule:nth-last-child(1)">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Grid.settingRow">
      <Setter Property="MinHeight" Value="{DynamicResource PageRowHeight}" />
      <Setter Property="Margin" Value="{DynamicResource PageRowPadding}" />
    </Style>
    <Style Selector="TextBlock.sectionHeading">
      <Setter Property="FontSize" Value="{DynamicResource SectionHeadingSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="LetterSpacing" Value="0.24" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="TextBlock.rowTitle">
      <Setter Property="FontSize" Value="{DynamicResource PageRowTitleSize}" />
    </Style>

    <!-- Listening. Accented rather than merely focused, because the page is about to
         swallow the next key press and the user has to be able to see that it will. -->
    <Style Selector="Button.gesture.recording">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.gesture">
      <Setter Property="MinWidth" Value="180" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left">

    <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="620"
               Text="The shortcuts work while the application is running, in any window. They act on the primary device — the one whose state the tray mark shows." />

    <TextBlock Classes="sectionHeading" Text="ACTIONS" />
    <Border Classes="sectionCard">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pages:HotkeyRowViewModel">
            <Border Classes="rule">
              <Grid Classes="settingRow" ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                            Margin="{DynamicResource PageRowGapRight}">
                  <TextBlock Classes="rowTitle" Text="{Binding Action.Title}" />

                  <!-- The explanation, or what is wrong with the binding. Never both:
                       when something is wrong that is the only thing worth reading. -->
                  <TextBlock Classes="caption" IsVisible="{Binding !HasProblem}"
                             Text="{Binding Action.Description}" />
                  <TextBlock IsVisible="{Binding HasProblem}"
                             FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource WarningBrush}"
                             TextWrapping="Wrap"
                             Text="{Binding Problem}" />
                </StackPanel>

                <Button Grid.Column="1" Classes="gesture"
                        Classes.recording="{Binding IsRecording}"
                        Command="{Binding RecordCommand}"
                        Content="{Binding Label}" />

                <Button Grid.Column="2" Margin="8,0,0,0"
                        Content="Clear"
                        IsVisible="{Binding HasGesture}"
                        Command="{Binding $parent[ItemsControl].((pages:HotkeysViewModel)DataContext).ClearCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

  </StackPanel>

</UserControl>
