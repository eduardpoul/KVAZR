<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Maxwell.App.ViewModels"
             x:Class="Maxwell.App.Views.Pages.WelcomeView"
             x:DataType="vm:ShellViewModel">

  <!--
    Artboard 6c. The screen shown when nothing is attached, and the most important one in
    the application despite being the one shown least: it is the only moment where
    nothing else on the page is competing to say what this program is for. Naming the
    three classes it can drive, and what it does with each, is a promise the rest of the
    interface then has to keep.

    Not an error state. Nothing has gone wrong when a device is simply not plugged in.
  -->

  <UserControl.Styles>
    <Style Selector="Border.introCard">
      <Setter Property="Background" Value="{DynamicResource LayerCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource EmptyCardRadiusCorner}" />
      <Setter Property="Padding" Value="{DynamicResource EmptyCardPadding}" />
    </Style>
    <Style Selector="Path.introGlyph">
      <Setter Property="Width" Value="{DynamicResource EmptyGlyphSize}" />
      <Setter Property="Height" Value="{DynamicResource EmptyGlyphSize}" />
      <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.introTitle">
      <Setter Property="FontSize" Value="{DynamicResource EmptyCardTitleSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.introBody">
      <Setter Property="FontSize" Value="{DynamicResource EmptyCardBodySize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="17" />
    </Style>
  </UserControl.Styles>

  <!-- Its own breathing room. The artboard gives this pane 60 by 64 of padding, which
       is far more than the device list wants and is the point: with one thing on the
       screen, the space around it is what says the screen is finished rather than empty. -->
  <StackPanel Spacing="28" MaxWidth="820" HorizontalAlignment="Left" Margin="30,24,24,24">


    <StackPanel Spacing="12" MaxWidth="520">
      <TextBlock FontSize="{DynamicResource EmptyTitleSize}" FontWeight="SemiBold"
                 LetterSpacing="-0.5"
                 Text="Plug a device in" />
      <TextBlock FontSize="{DynamicResource EmptyBodySize}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 TextWrapping="Wrap" LineHeight="22"
                 Text="KVAZR shows the charge in the tray and sets up wireless peripherals from several makers — without a vendor suite each. Plug a headset in by cable or dongle, a mouse or a keyboard, and they turn up here by themselves." />
    </StackPanel>

    <Grid ColumnDefinitions="*,*,*">
      <Border Grid.Column="0" Classes="introCard" Margin="0,0,7,0">
        <StackPanel Spacing="12">
          <Path Classes="introGlyph"
                Data="M9 30V24a15 15 0 0 1 30 0v6 M6 29h5a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-9Z M42 29h-5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3a2 2 0 0 0 2-2v-9Z" />
          <TextBlock Classes="introTitle" Text="Headsets" />
          <TextBlock Classes="introBody"
                     Text="Audeze Maxwell over USB-C and the dongle. Charge, sound, microphone, ChatMix" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="introCard" Margin="7,0">
        <StackPanel Spacing="12">
          <Path Classes="introGlyph"
                Data="M24 5c-7 0-11 5-11 12v14c0 7 4 12 11 12s11-5 11-12V17c0-7-4-12-11-12Z M24 11v9" />
          <TextBlock Classes="introTitle" Text="Mice" />
          <TextBlock Classes="introBody"
                     Text="Logitech over the dongle and Bluetooth. DPI, report rate, buttons" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="introCard" Margin="7,0,0,0">
        <StackPanel Spacing="12">
          <Path Classes="introGlyph"
                Data="M4 13h40v22H4z M11 20h2M18 20h2M25 20h2M32 20h2M11 27h26" />
          <TextBlock Classes="introTitle" Text="Keyboards" />
          <TextBlock Classes="introBody"
                     Text="NuPhy and anything VIA-compatible. Layers, macros, lighting" />
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
      <Button Classes="accent" Content="Look for devices"
              Command="{Binding RediscoverCommand}" />
      <TextBlock Classes="caption" VerticalAlignment="Center"
                 Text="The application keeps watching for connections in the background" />
    </StackPanel>

  </StackPanel>

</UserControl>
