<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Maxwell.App.ViewModels.Pages"
             x:Class="Maxwell.App.Views.Pages.SettingsView"
             x:DataType="pages:SettingsViewModel">

  <!--
    Artboard 7a, plus the hidden-devices section from 13b.

    The sections are the same cards of rows the device page uses, and that is the point of
    having a design system at all: a setting of the application and a setting of a device
    are the same kind of thing to the person changing them, so they had better look it.

    No Apply button and no Cancel. A switch that has visibly moved but has not taken
    effect is a lie the screen is telling, and given the choice somebody will always close
    the window without pressing Apply.
  -->

  <UserControl.Styles>
    <Style Selector="Border.sectionCard">
      <Setter Property="Background" Value="{DynamicResource LayerCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Grid.settingRow">
      <Setter Property="MinHeight" Value="{DynamicResource SettingsRowHeight}" />
      <Setter Property="Margin" Value="{DynamicResource SettingsRowPadding}" />
    </Style>

    <Style Selector="Border.rule">
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="TextBlock.sectionHeading">
      <Setter Property="FontSize" Value="{DynamicResource SectionHeadingSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="LetterSpacing" Value="0.24" />
      <Setter Property="LineHeight" Value="{DynamicResource SectionHeadingLine}" />
    </Style>

    <Style Selector="TextBlock.rowTitle">
      <Setter Property="FontSize" Value="{DynamicResource PageRowTitleSize}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="{DynamicResource ContentGap}" MaxWidth="820"
              HorizontalAlignment="Left">

    <!-- Heading and card are one group: eight pixels apart, sixteen from the next. -->
    <StackPanel Spacing="8">
      <TextBlock Classes="sectionHeading" Text="APPEARANCE" />
      <Border Classes="sectionCard">
        <StackPanel>
          <Border Classes="rule">
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                          Margin="{DynamicResource PageRowGapRight}">
                <TextBlock Classes="rowTitle" Text="Theme" />
                <TextBlock Classes="caption" Text="System follows the Windows appearance" />
              </StackPanel>
              <ListBox Grid.Column="1" Classes="segmented" SelectedIndex="{Binding ThemeIndex}">
                <ListBoxItem>System</ListBoxItem>
                <ListBoxItem>Light</ListBoxItem>
                <ListBoxItem>Dark</ListBoxItem>
              </ListBox>
            </Grid>
          </Border>

          <!--
            Disabled with the reason beside it, which is the state the design system already
            has for exactly this: the control exists, the reason it cannot be used is next
            to it, and nothing pretends. The alternative was a dropdown that visibly moves
            and changes nothing, and a switch that has moved but not taken effect is the one
            thing this screen must never do.
          -->
          <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                        Margin="{DynamicResource PageRowGapRight}">
              <TextBlock Classes="rowTitle" Text="Language" />
              <TextBlock Classes="caption" Text="Takes effect at once, no restart" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="{DynamicResource SettingsLanguageWidth}"
                      HorizontalAlignment="Right"
                      IsEnabled="False"
                      ItemsSource="{Binding Languages}"
                      SelectedIndex="{Binding LanguageIndex}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Heading and card are one group: eight pixels apart, sixteen from the next. -->
    <StackPanel Spacing="8">
      <TextBlock Classes="sectionHeading" Text="STARTUP AND TRAY" />
      <Border Classes="sectionCard">
        <StackPanel>
          <Border Classes="rule">
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="rowTitle" VerticalAlignment="Center"
                         Margin="{DynamicResource PageRowGapRight}"
                         Text="Start with Windows" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunAtLogin}" />
            </Grid>
          </Border>

          <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="rowTitle" VerticalAlignment="Center"
                       Margin="{DynamicResource PageRowGapRight}"
                       Text="Closing the window hides it in the tray" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimiseOnClose}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Heading and card are one group: eight pixels apart, sixteen from the next. -->
    <StackPanel Spacing="8">
      <TextBlock Classes="sectionHeading" Text="NOTIFICATIONS AND POLLING" />
      <Border Classes="sectionCard">
        <StackPanel>
          <Border Classes="rule">
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                          Margin="{DynamicResource PageRowGapRight}">
                <TextBlock Classes="rowTitle" Text="Low battery threshold" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Said once per discharge" />
              </StackPanel>
              <Grid Grid.Column="1" Width="{DynamicResource SettingsSliderWidth}"
                    ColumnDefinitions="*,Auto">
                <Slider Grid.Column="0" Minimum="5" Maximum="50" TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding LowBatteryThreshold}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="value"
                           MinWidth="{DynamicResource SettingsValueWidth}"
                           TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding LowBatteryLabel}" />
              </Grid>
            </Grid>
          </Border>


          <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                        Margin="{DynamicResource PageRowGapRight}">
              <TextBlock Classes="rowTitle" Text="How often devices are asked" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="More often means a fresher reading and a flatter battery" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="{DynamicResource SettingsIntervalWidth}"
                      HorizontalAlignment="Right"
                      ItemsSource="{Binding PollIntervals}"
                      SelectedIndex="{Binding PollIntervalIndex}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

      <!--
        Artboard 13b. Hidden is not forgotten: the pairing in Windows is untouched and the
        device comes back whole. Saying that here, where the way back is, is what keeps
        hiding from feeling like deleting.
    -->
    <!-- Heading and card are one group: eight pixels apart, sixteen from the next. -->
    <StackPanel Spacing="8">
      <TextBlock Classes="sectionHeading" Text="{Binding HiddenHeading}" />
      <Border Classes="sectionCard">
        <StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Margin="16,14,16,4"
                     Text="These devices are absent from the dashboard, the tray and the notifications. The Windows pairings are untouched: put one back in the list and its readings resume." />

          <ItemsControl ItemsSource="{Binding Hidden}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pages:HiddenDeviceViewModel">
                <Border Classes="rule">
                  <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                                Margin="{DynamicResource PageRowGapRight}">
                      <TextBlock Classes="rowTitle" Text="{Binding DisplayName}" />
                      <TextBlock Classes="caption" Text="{Binding When}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Restore to the list"
                            Command="{Binding RestoreCommand}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="caption" Margin="16,10,16,14"
                     IsVisible="{Binding !HasHidden}"
                     Text="Nothing is hidden." />

          <Border Classes="rule">
            <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                          Margin="{DynamicResource PageRowGapRight}">
                <TextBlock Classes="rowTitle" Text="Hide new devices that report nothing" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Anything reporting neither a name nor a class goes straight to hidden" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideSilentDevices}" />
            </Grid>
          </Border>

          <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                        Margin="{DynamicResource PageRowGapRight}">
              <TextBlock Classes="rowTitle" Text="Restore all" />
              <TextBlock Classes="caption" Text="Hidden devices come back to the dashboard" />
            </StackPanel>
            <Button Grid.Column="1" Content="Restore all"
                    IsEnabled="{Binding HasHidden}"
                    Command="{Binding ShowAllHiddenCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

  </StackPanel>

</UserControl>
