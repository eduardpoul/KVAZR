<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Maxwell.App.ViewModels.Pages"
             xmlns:conv="using:Maxwell.App.Converters"
             x:Class="Maxwell.App.Views.Pages.SettingsView"
             x:DataType="pages:SettingsViewModel">

  <StackPanel Spacing="12">

    <!-- Appearance -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Тема" />
            <TextBlock Classes="caption" Text="Системная следует за настройкой Windows" />
          </StackPanel>
          <ListBox Grid.Column="1" Classes="segmented"
                   ItemsSource="{Binding Themes}"
                   SelectedItem="{Binding Theme}"
                   VerticalAlignment="Center">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static conv:ThemeLabelConverter.Instance}}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Startup and tray -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Запускать вместе с Windows" />
            <TextBlock Classes="caption" Text="Запись в ветке текущего пользователя, права администратора не нужны" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunAtLogin}"
                        OnContent="" OffContent="" VerticalAlignment="Center" />
        </Grid>

        <Separator Classes="divider" />

        <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding RunAtLogin}">
          <TextBlock Grid.Column="0" Text="Свёрнутым в область уведомлений"
                     VerticalAlignment="Center" />
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimised}"
                        OnContent="" OffContent="" VerticalAlignment="Center" />
        </Grid>

        <Separator Classes="divider" />

        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Процент заряда в значке" />
            <TextBlock Classes="caption" Text="Иначе в трее будет простой значок без цифры" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPercentageInTray}"
                        OnContent="" OffContent="" VerticalAlignment="Center" />
        </Grid>

        <Separator Classes="divider" />

        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Попап при подключении" />
            <TextBlock Classes="caption" Text="Показывает заряд при подключении наушников" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowConnectPopup}"
                        OnContent="" OffContent="" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Notifications -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Уведомление о низком заряде" />
            <TextBlock Classes="caption"
                       Text="Предупреждение приходит один раз на разряд и повторяется только после зарядки" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyLowBattery}"
                        OnContent="" OffContent="" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Spacing="6" IsEnabled="{Binding NotifyLowBattery}">
          <Grid Classes="row" ColumnDefinitions="*,Auto" MinHeight="24">
            <TextBlock Grid.Column="0" Text="Порог" />
            <TextBlock Grid.Column="1" Classes="value" Text="{Binding LowBatteryThresholdText}" />
          </Grid>
          <Slider Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                  Value="{Binding LowBatteryThreshold}" />
        </StackPanel>

        <Separator Classes="divider" />

        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Уведомление о завершении зарядки"
                     VerticalAlignment="Center" />
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyChargeComplete}"
                        OnContent="" OffContent="" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- About -->
    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Classes="cardTitle" Text="Maxwell.App" />
        <TextBlock Classes="secondary" Text="{Binding Version, StringFormat='Версия {0}'}" />
        <TextBlock Classes="caption" Text="Работает офлайн, без сбора данных и подписок." />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
