<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Maxwell.App.ViewModels.Pages"
             x:Class="Maxwell.App.Views.Pages.AdvancedView"
             x:DataType="pages:AdvancedViewModel">

  <StackPanel Spacing="12">

    <Border Classes="card" IsVisible="{Binding !IsAvailable}">
      <StackPanel Spacing="8">
        <TextBlock Classes="cardTitle" Text="Нужен кабель USB-C" />
        <TextBlock Classes="secondary"
                   Text="Эти операции идут напрямую в наушники, а донгл команды не передаёт." />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Проверить подключение" />
            <TextBlock Classes="caption" Text="Перечитывает устройство и показывает, что именно отвечает" />
          </StackPanel>
          <Button Grid.Column="1" Content="Запустить" VerticalAlignment="Center"
                  Command="{Binding RunDiagnosticsCommand}" IsEnabled="{Binding !Busy}" />
        </Grid>

        <TextBlock Classes="secondary" Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Обновление прошивки" />
            <TextBlock Classes="caption"
                       Text="{Binding FirmwareText}" />
          </StackPanel>
          <Border Grid.Column="1" Classes="pill">
            <TextBlock Text="не реализовано" />
          </Border>
        </Grid>
        <TextBlock Classes="caption"
                   Text="Прошивка обновляется по протоколу FOTA, который мы не разбирали. Пока пользуйтесь официальным Audeze HQ." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsAvailable}">
      <StackPanel Spacing="10">
        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Сопряжение с донглом" />
            <TextBlock Classes="caption" Text="Разорвёт текущую пару — потребуется сопрячь заново" />
          </StackPanel>
          <Button Grid.Column="1" Content="{Binding PairingButtonText}" VerticalAlignment="Center"
                  Command="{Binding StartPairingCommand}" IsEnabled="{Binding !Busy}" />
        </Grid>

        <Separator Classes="divider" />

        <Grid Classes="row" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="cardTitle" Text="Сброс к заводским настройкам"
                       Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Classes="caption"
                       Text="Стирает пресеты, баланс чашек и уровни громкости. Отменить нельзя." />
          </StackPanel>
          <Button Grid.Column="1" Content="{Binding ResetButtonText}" VerticalAlignment="Center"
                  Command="{Binding FactoryResetCommand}" IsEnabled="{Binding !Busy}" />
        </Grid>

        <Button Content="Отменить подтверждение" Command="{Binding CancelArmingCommand}"
                HorizontalAlignment="Left"
                IsVisible="{Binding ResetArmed}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
