<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Maxwell.App.Controls"
        xmlns:cap="using:Maxwell.App.ViewModels.Capabilities"
        xmlns:controls="using:Maxwell.App.Controls"
        xmlns:devices="using:Maxwell.App.ViewModels.Devices"
        xmlns:vm="using:Maxwell.App.ViewModels"
        x:Class="Maxwell.App.Views.FlyoutWindow"
        x:DataType="vm:FlyoutViewModel"
        Width="360"
        SizeToContent="Height"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CornerRadius="8"
        Background="{DynamicResource LayerCardBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="{DynamicResource FontSizeBody}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <!--
    The width is the literal 360 rather than the FlyoutWidth token, and that is not an
    oversight: a window is measured before its resources are attached, so a DynamicResource
    there resolves to nothing and the panel opens with no size at all. Everything inside it
    is on tokens, where the lookup happens after attachment.

    Turn 12. Every device is the same 56-pixel row and none of them starts open. The
    earlier arrangement gave one device a picture and controls at the top; the trouble
    with it was not how it looked but that the panel decided which device mattered, by a
    rule that is right about as often as it is wrong.

    The list is capped at five rows and scrolls past that, so opening a row does not make
    the panel taller. A tray panel that grows down the screen as devices connect is one
    that eventually cannot be dismissed by clicking beside it.
  -->

  <Window.Styles>
    <!-- The open row grows a surface of its own, so the controls inside read as
         belonging to the device named above them rather than floating between rows. -->
    <Style Selector="Border.deviceRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--
      Its own style rather than the navigation pane's. That class pins button heights to
      36, and borrowing it silently held these rows twenty pixels short of the artboard —
      which is the kind of thing that only shows when the render is put beside the design.
    -->
    <Style Selector="Button.deviceRowButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource FlyoutRowRadiusCorner}" />
      <Setter Property="Padding" Value="{DynamicResource FlyoutRowPadding}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.deviceRowButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
    </Style>

    <Style Selector="Button.footerRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Height" Value="{DynamicResource FlyoutFooterHeight}" />
      <Setter Property="Padding" Value="{DynamicResource FlyoutFooterPadding}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.footerRow:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
    </Style>
    <Style Selector="Border.deviceRow.open">
      <Setter Property="Background" Value="{DynamicResource LayerAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefaultBrush}" />
    </Style>
  </Window.Styles>

  <Border BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="8">
    <DockPanel>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto"
            Margin="{DynamicResource FlyoutHeaderPadding}">
        <TextBlock Grid.Column="0"
                   FontSize="{DynamicResource FlyoutHeaderSize}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="{Binding Heading}" />
        <Path Grid.Column="1" Width="15" Height="15" VerticalAlignment="Center"
              Stroke="{DynamicResource TextTertiaryBrush}"
              StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
              Stretch="Uniform"
              Data="M8 5.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8z M8 1.6v1.8M8 12.6v1.8M1.6 8h1.8M12.6 8h1.8M3.5 3.5l1.3 1.3M11.2 11.2l1.3 1.3M12.5 3.5l-1.3 1.3M4.8 11.2l-1.3 1.3" />
      </Grid>

      <!-- Pinned. Once the list reaches its ceiling the footer would scroll out of
           reach, and the way into the window is the one thing the panel must not hide. -->
      <Border DockPanel.Dock="Bottom"
              BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,1,0,0">
        <Button Classes="footerRow" Command="{Binding OpenSettingsCommand}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       FontSize="{DynamicResource FlyoutFooterSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Все настройки" />
            <Path Grid.Column="1" Width="11" Height="11" VerticalAlignment="Center"
                  Stroke="{DynamicResource TextSecondaryBrush}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Stretch="Uniform"
                  Data="M6 3.6 10.4 8 6 12.4" />
          </Grid>
        </Button>
      </Border>

      <!--
        The heading above and the settings link below are on screen from the first frame:
        neither waits on a device answering. Only the rows are unknown, so only the rows
        get placeholders.
      -->
      <StackPanel DockPanel.Dock="Top" Margin="16,0" IsVisible="{Binding Loading.ShowSkeleton}">
        <Grid ColumnDefinitions="Auto,*,Auto" Height="{DynamicResource FlyoutRowHeight}">
          <controls:Skeleton Grid.Column="0" Width="{DynamicResource FlyoutThumbSize}" Height="{DynamicResource FlyoutThumbSize}" Radius="{DynamicResource FlyoutThumbRadius}"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
            <controls:Skeleton Width="132" Height="9" Phase="1" HorizontalAlignment="Left" />
            <controls:Skeleton Width="84" Height="7" Phase="2" HorizontalAlignment="Left" />
          </StackPanel>
          <controls:Skeleton Grid.Column="2" Width="36" Height="10" Phase="3" VerticalAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto" Height="{DynamicResource FlyoutRowHeight}">
          <controls:Skeleton Grid.Column="0" Width="{DynamicResource FlyoutThumbSize}" Height="{DynamicResource FlyoutThumbSize}" Radius="{DynamicResource FlyoutThumbRadius}" Phase="2"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
            <controls:Skeleton Width="112" Height="9" Phase="3" HorizontalAlignment="Left" />
            <controls:Skeleton Width="70" Height="7" Phase="4" HorizontalAlignment="Left" />
          </StackPanel>
          <controls:Skeleton Grid.Column="2" Width="36" Height="10" Phase="5" VerticalAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto" Height="{DynamicResource FlyoutRowHeight}">
          <controls:Skeleton Grid.Column="0" Width="{DynamicResource FlyoutThumbSize}" Height="{DynamicResource FlyoutThumbSize}" Radius="{DynamicResource FlyoutThumbRadius}" Phase="3"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
            <controls:Skeleton Width="96" Height="9" Phase="4" HorizontalAlignment="Left" />
            <controls:Skeleton Width="62" Height="7" Phase="5" HorizontalAlignment="Left" />
          </StackPanel>
          <controls:Skeleton Grid.Column="2" Width="36" Height="10" Phase="6" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <!-- Ten seconds with no answer. Text, never a placeholder that never stops. -->
      <TextBlock DockPanel.Dock="Top" Classes="secondary" Margin="16,8,16,12"
                 IsVisible="{Binding Loading.ShowError}"
                 Text="Опрос не отвечает" />

      <!-- Nothing attached. Short, because the tray is not the place to explain. -->
      <TextBlock DockPanel.Dock="Top" Classes="secondary" Margin="16,8,16,12"
                 Text="Устройств не найдено">
        <TextBlock.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!HasDevices" />
            <Binding Path="Loading.ShowContent" />
          </MultiBinding>
        </TextBlock.IsVisible>
      </TextBlock>

      <!-- Five rows of 56 and the padding they sit in. Past that the list scrolls inside
           the panel rather than the panel growing off the screen. -->
      <ScrollViewer MaxHeight="{DynamicResource FlyoutListHeight}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding Loading.ShowContent}">
        <ItemsControl ItemsSource="{Binding Devices}" Margin="{DynamicResource FlyoutListPadding}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="devices:FlyoutRowViewModel">

              <Border Classes="deviceRow" Classes.open="{Binding IsOpen}"
                      CornerRadius="{DynamicResource FlyoutThumbRadiusCorner}" BorderThickness="1" Margin="0,0,0,1">
                <StackPanel>

                  <!-- Height on the button, not on the grid inside it: the shared
                       navRoot style pins buttons to 36, and a setter there beats
                       anything a child asks for. This row is 56 because the artboard
                       says 56, and Metrics.axaml has that number from the design file
                       rather than from anyone's memory. -->
                  <Button Classes="deviceRowButton" Command="{Binding ToggleCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          Height="{DynamicResource FlyoutRowHeight}">
                      <Border Grid.Column="0"
                              Width="{DynamicResource FlyoutThumbSize}"
                              Height="{DynamicResource FlyoutThumbSize}"
                              Background="{DynamicResource LayerAltBrush}"
                              CornerRadius="{DynamicResource FlyoutThumbRadiusCorner}"
                              ClipToBounds="True"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center">
                        <ctl:DeviceThumb Photo="{Binding Device.Photo}" Glyph="{Binding Device.Glyph}" />
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock FontSize="{DynamicResource FlyoutNameSize}" FontWeight="SemiBold"
                                   Text="{Binding Device.DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" FontSize="{DynamicResource FlyoutSubSize}"
                                   Text="{Binding Device.Status}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <controls:KvazrMarkControl Grid.Column="2" Width="18" Height="18"
                                                 Motion="Fast" OrbitShade="Resting"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding Device.IsBatteryPending}" />

                      <TextBlock Grid.Column="2" FontSize="{DynamicResource FlyoutBatterySize}" FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding !Device.IsBatteryPending}"
                                 Text="{Binding Device.Battery}" />

                      <Path Grid.Column="3" Width="10" Height="10" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                            Stretch="Uniform"
                            IsVisible="{Binding !IsOpen}"
                            Data="M3.6 6 8 10.4 12.4 6" />

                      <Path Grid.Column="3" Width="10" Height="10" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource TextPrimaryBrush}"
                            StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                            Stretch="Uniform"
                            IsVisible="{Binding IsOpen}"
                            Data="M3.6 10.4 8 6l4.4 4.4" />
                    </Grid>
                  </Button>

                  <!-- Indented to the name rather than to the edge: the controls belong
                       to the device above them, and the picture column says so. -->
                  <StackPanel IsVisible="{Binding IsOpen}" Margin="54,2,12,14" Spacing="12">

                    <ItemsControl ItemsSource="{Binding Quick}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="cap:CapabilityViewModel">
                          <StackPanel Spacing="5" Margin="0,0,0,2">
                            <TextBlock Classes="caption" FontSize="12" Text="{Binding Title}" />
                            <controls:CapabilityControl HorizontalAlignment="Stretch" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Said out loud rather than left blank. "Connected, and there is
                         nothing here to set" is something a person can act on; an empty
                         gap under an opened row reads as a fault. -->
                    <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding HasNothing}"
                               Text="Настраивать нечего: устройство отдаёт только то, что уже в строке." />

                    <Button Classes="navRoot"
                            Command="{Binding OpenPageCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            IsVisible="{Binding !HasNothing}">
                      <TextBlock FontSize="12" Text="Открыть страницу устройства" Margin="8,0" />
                    </Button>
                  </StackPanel>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>
  </Border>

</Window>
