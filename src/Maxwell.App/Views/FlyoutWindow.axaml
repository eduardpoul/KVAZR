<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Maxwell.App.Controls"
        xmlns:cap="using:Maxwell.App.ViewModels.Capabilities"
        xmlns:controls="using:Maxwell.App.Controls"
        xmlns:conv="using:Maxwell.App.Converters"
        xmlns:devices="using:Maxwell.App.ViewModels.Devices"
        xmlns:vm="using:Maxwell.App.ViewModels"
        x:Class="Maxwell.App.Views.FlyoutWindow"
        x:DataType="vm:FlyoutViewModel"
        Width="360"
        MaxHeight="600"
        SizeToContent="Height"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CornerRadius="8"
        Background="{DynamicResource LayerCardBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="{DynamicResource FontSizeBody}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <!--
    Artboard 3a-3c. 360 wide, and the height is capped at 600 because six devices reach
    it — past that the list scrolls rather than growing off the screen.

    The primary device gets a picture and two or three controls; every other device is
    one row. Anything beyond a glance and a nudge belongs in the window.
  -->

  <Window.Resources>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource StrokeDefaultBrush}" BorderThickness="1" CornerRadius="8">
    <DockPanel>

      <!-- Pinned. Once six devices push the list past the height ceiling the footer
           would scroll out of reach, and the way into the window would be the one
           thing the panel hides. -->
      <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,12" Spacing="8">
        <Separator Classes="divider" Margin="0" />
        <Button Classes="navRoot"
                Command="{Binding OpenSettingsCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
          <TextBlock Text="Все настройки" Margin="8,0" />
        </Button>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,16,16,8" Spacing="12">

          <TextBlock Classes="caption" Text="{Binding Heading}" />

          <!--
            The heading above and the settings link below are on screen from the first
            frame: neither depends on any device answering. Only the rows are unknown,
            so only the rows get placeholders.
          -->
          <StackPanel Spacing="12" IsVisible="{Binding Loading.ShowSkeleton}">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="64">
              <controls:Skeleton Grid.Column="0" Width="64" Height="64" Radius="4" Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <controls:Skeleton Width="152" Height="10" Phase="1" HorizontalAlignment="Left" />
                <controls:Skeleton Width="94" Height="7" Phase="2" HorizontalAlignment="Left" />
              </StackPanel>
              <controls:Skeleton Grid.Column="2" Width="42" Height="12" Phase="3" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" Height="56">
              <controls:Skeleton Grid.Column="0" Width="34" Height="34" Radius="4" Phase="2"
                                 Margin="0,0,12,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <controls:Skeleton Width="128" Height="9" Phase="3" HorizontalAlignment="Left" />
                <controls:Skeleton Width="78" Height="7" Phase="4" HorizontalAlignment="Left" />
              </StackPanel>
              <controls:Skeleton Grid.Column="2" Width="36" Height="9" Phase="5" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" Height="56">
              <controls:Skeleton Grid.Column="0" Width="34" Height="34" Radius="4" Phase="3"
                                 Margin="0,0,12,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <controls:Skeleton Width="106" Height="9" Phase="4" HorizontalAlignment="Left" />
                <controls:Skeleton Width="66" Height="7" Phase="5" HorizontalAlignment="Left" />
              </StackPanel>
              <controls:Skeleton Grid.Column="2" Width="36" Height="9" Phase="6" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <!-- Ten seconds with no answer. Text, never a placeholder that never stops. -->
          <TextBlock Classes="secondary"
                     IsVisible="{Binding Loading.ShowError}"
                     Text="Опрос не отвечает" />

          <!-- Nothing attached. Short, because the tray is not the place to explain. -->
          <TextBlock Classes="secondary" Text="Устройств не найдено">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!HasDevices" />
                <Binding Path="Loading.ShowContent" />
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>

          <!-- Primary device -->
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasDevices}">
            <Border Grid.Column="0" Width="64" Height="64"
                    Background="{DynamicResource LayerAltBrush}"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    ClipToBounds="True"
                    Margin="0,0,14,0">
              <ctl:DeviceThumb Photo="{Binding Primary.Photo}" Glyph="{Binding Primary.Glyph}" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="cardTitle" Text="{Binding Primary.DisplayName}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption" Text="{Binding Primary.Status}" />
            </StackPanel>

            <controls:KvazrMarkControl Grid.Column="2" Width="20" Height="20"
                                       Motion="Fast" OrbitShade="Resting"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding Primary.IsBatteryPending}" />

            <TextBlock Grid.Column="2"
                       FontSize="{DynamicResource FontSizeSubtitle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !Primary.IsBatteryPending}"
                       Text="{Binding Primary.Battery}" />
          </Grid>

          <!-- Quick controls. Label and value on one line, the control under it: at
               360 px a slider and a label do not share a row without one of them
               becoming useless. -->
          <ItemsControl ItemsSource="{Binding Quick}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cap:CapabilityViewModel">
                <StackPanel Spacing="4" Margin="0,4">
                  <TextBlock Classes="caption" Text="{Binding Title}" />
                  <controls:CapabilityControl HorizontalAlignment="Stretch" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator Classes="divider" IsVisible="{Binding HasOthers}" />

          <!-- Every other device: 56 px, name and battery, nothing else. -->
          <ItemsControl ItemsSource="{Binding Others}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="devices:DeviceListItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="56">
                  <Border Grid.Column="0" Width="34" Height="34"
                          Background="{DynamicResource LayerAltBrush}"
                          CornerRadius="{DynamicResource RadiusSmall}"
                          ClipToBounds="True"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center">
                    <ctl:DeviceThumb Photo="{Binding Photo}" Glyph="{Binding Glyph}" />
                  </Border>

                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding Status}" />
                  </StackPanel>

                  <controls:KvazrMarkControl Grid.Column="2" Width="20" Height="20"
                                             Motion="Fast" OrbitShade="Resting"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding IsBatteryPending}" />

                  <TextBlock Grid.Column="2" Classes="secondary"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !IsBatteryPending}"
                             Text="{Binding Battery}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>

</Window>
