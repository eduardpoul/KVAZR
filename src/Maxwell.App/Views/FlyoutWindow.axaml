<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Maxwell.App.Controls"
        xmlns:cap="using:Maxwell.App.ViewModels.Capabilities"
        xmlns:controls="using:Maxwell.App.Controls"
        xmlns:devices="using:Maxwell.App.ViewModels.Devices"
        xmlns:core="using:Maxwell.Core.Devices"
        xmlns:vm="using:Maxwell.App.ViewModels"
        xmlns:sys="using:System"
        x:Class="Maxwell.App.Views.FlyoutWindow"
        x:DataType="vm:FlyoutViewModel"
        Width="360"
        SizeToContent="Height"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CornerRadius="8"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="{DynamicResource FontSizeBody}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <!--
    The width is the literal 360 rather than the FlyoutWidth token, and that is not an
    oversight: a window is measured before its resources are attached, so a DynamicResource
    there resolves to nothing and the panel opens with no size at all. Everything inside it
    is on tokens, where the lookup happens after attachment.

    Turn 12. Every device is the same 56-pixel row and none of them starts open. The
    earlier arrangement gave one device a picture and controls at the top; the trouble
    with it was not how it looked but that the panel decided which device mattered, by a
    rule that is right about as often as it is wrong.

    The list is capped at five rows and scrolls past that, so opening a row does not make
    the panel taller. A tray panel that grows down the screen as devices connect is one
    that eventually cannot be dismissed by clicking beside it.
  -->


  <Window.Styles>
    <!-- The open row grows a surface of its own, so the controls inside read as
         belonging to the device named above them rather than floating between rows. -->
    <Style Selector="Border.deviceRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--
      Its own style rather than the navigation pane's. That class pins button heights to
      36, and borrowing it silently held these rows twenty pixels short of the artboard —
      which is the kind of thing that only shows when the render is put beside the design.
    -->
    <Style Selector="Button.deviceRowButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource FlyoutRowRadiusCorner}" />
      <Setter Property="Padding" Value="{DynamicResource FlyoutRowPadding}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.deviceRowButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
    </Style>

    <Style Selector="Button.footerRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Height" Value="{DynamicResource FlyoutFooterHeight}" />
      <Setter Property="Padding" Value="{DynamicResource FlyoutFooterPadding}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.footerRow:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
    </Style>
    <!-- The opened row and everything under it are one surface, so the controls read as
         belonging to the device named above them. The whole block, not just the 56-pixel
         row: a card that stopped at the name would leave its own controls outside it. -->
    <Style Selector="Border.deviceRow.open">
      <Setter Property="Background" Value="{DynamicResource LayerCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- A row of text that happens to be clickable, but still a row: Fluent gives a list
         item 32 pixels and a 4-pixel radius, and a hover that hugs the glyphs instead of
         filling the row reads as a rendering fault rather than as a target. -->
    <Style Selector="Button.quietLink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Fluent's own slider, trimmed to the artboard's footprint.
         It reserves room for a header and a tick strip that this panel never uses, and
         left alone that spare height reads as a gap between a control and its own name —
         the 5 pixels the drawing puts there became nearer twenty. -->
    <!--
      Fluent's slider stands 46 pixels tall: a 4-pixel track with a header strip and a
      tick strip reserved around it, neither of which this panel uses. The artboard gives
      the row 18, and the difference showed up as a gap between a control and its own
      name wide enough to look like a mistake.

      Height does not touch it — the reservations are inside the template — and the theme
      resources that do are resolved statically inside the control theme, where a window
      cannot reach them. So the spare is taken back with a negative margin: the stock
      control keeps its behaviour, and only the space it reserves and never draws in is
      removed. Measured, not guessed: 14 a side brings the block pitch from 79 to the
      drawing's 51.
    -->
    <Style Selector="Slider.quick">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,-14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- It is a link, but it still has to answer the pointer. The text and the chevron
         carry explicit colours, so the hover has to reach them by name: setting the
         inherited foreground alone changed nothing at all, which is why this row was the
         one thing in the panel that did not light up. -->
    <Style Selector="Button.quietLink:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
    </Style>
    <Style Selector="Button.quietLink:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.quietLink:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- The choice and command rows: one 30-pixel line, control against the right edge. -->
    <Style Selector="ComboBox.quick">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Width" Value="150" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.quick">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>


  <Panel>

    <!--
      The sheet the panel is drawn on. Turn 12 makes it translucent over whatever is
      behind it, which is why the window itself is transparent and this paints instead of
      Window.Background. FallbackColor is the load-bearing part: where the compositor
      offers no blur — a remote session, a machine with transparency turned off — this
      resolves to the flat tint rather than to nothing, and a tray panel that renders as
      a black rectangle is a worse failure than one that is merely opaque.
    -->
    <ExperimentalAcrylicBorder IsHitTestVisible="False" CornerRadius="8">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                     TintColor="{DynamicResource FlyoutTintColor}"
                                     TintOpacity="1"
                                     MaterialOpacity="0.86"
                                     FallbackColor="{DynamicResource FlyoutTintColor}" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <Border BorderBrush="{DynamicResource FlyoutStrokeBrush}" BorderThickness="1" CornerRadius="8">
    <DockPanel>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto"
            Margin="{DynamicResource FlyoutHeaderPadding}">
        <TextBlock Grid.Column="0"
                   FontSize="{DynamicResource FlyoutHeaderSize}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="{Binding Heading}" />
        <Path Grid.Column="1" Width="15" Height="15" VerticalAlignment="Center"
              Stroke="{DynamicResource TextTertiaryBrush}"
              StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
              Stretch="Uniform"
              Data="M8 5.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8z M8 1.6v1.8M8 12.6v1.8M1.6 8h1.8M12.6 8h1.8M3.5 3.5l1.3 1.3M11.2 11.2l1.3 1.3M12.5 3.5l-1.3 1.3M4.8 11.2l-1.3 1.3" />
      </Grid>

      <!-- Pinned. Once the list reaches its ceiling the footer would scroll out of
           reach, and the way into the window is the one thing the panel must not hide. -->
      <Border DockPanel.Dock="Bottom"
              BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,1,0,0">
        <Button Classes="footerRow" Command="{Binding OpenSettingsCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       FontSize="{DynamicResource FlyoutFooterSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Все настройки" />
            <Path Grid.Column="1" Width="11" Height="11" VerticalAlignment="Center"
                  Stroke="{DynamicResource TextSecondaryBrush}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Stretch="Uniform"
                  Data="M6 3.6 10.4 8 6 12.4" />
          </Grid>
        </Button>
      </Border>

      <!--
        The heading above and the settings link below are on screen from the first frame:
        neither waits on a device answering. Only the rows are unknown, so only the rows
        get placeholders.
      -->
      <StackPanel DockPanel.Dock="Top" Margin="16,0" IsVisible="{Binding Loading.ShowSkeleton}">
        <Grid ColumnDefinitions="Auto,*,Auto" Height="{DynamicResource FlyoutRowHeight}">
          <controls:Skeleton Grid.Column="0" Width="{DynamicResource FlyoutThumbSize}" Height="{DynamicResource FlyoutThumbSize}" Radius="{DynamicResource FlyoutThumbRadius}"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
            <controls:Skeleton Width="132" Height="9" Phase="1" HorizontalAlignment="Left" />
            <controls:Skeleton Width="84" Height="7" Phase="2" HorizontalAlignment="Left" />
          </StackPanel>
          <controls:Skeleton Grid.Column="2" Width="36" Height="10" Phase="3" VerticalAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto" Height="{DynamicResource FlyoutRowHeight}">
          <controls:Skeleton Grid.Column="0" Width="{DynamicResource FlyoutThumbSize}" Height="{DynamicResource FlyoutThumbSize}" Radius="{DynamicResource FlyoutThumbRadius}" Phase="2"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
            <controls:Skeleton Width="112" Height="9" Phase="3" HorizontalAlignment="Left" />
            <controls:Skeleton Width="70" Height="7" Phase="4" HorizontalAlignment="Left" />
          </StackPanel>
          <controls:Skeleton Grid.Column="2" Width="36" Height="10" Phase="5" VerticalAlignment="Center" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto" Height="{DynamicResource FlyoutRowHeight}">
          <controls:Skeleton Grid.Column="0" Width="{DynamicResource FlyoutThumbSize}" Height="{DynamicResource FlyoutThumbSize}" Radius="{DynamicResource FlyoutThumbRadius}" Phase="3"
                             Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
            <controls:Skeleton Width="96" Height="9" Phase="4" HorizontalAlignment="Left" />
            <controls:Skeleton Width="62" Height="7" Phase="5" HorizontalAlignment="Left" />
          </StackPanel>
          <controls:Skeleton Grid.Column="2" Width="36" Height="10" Phase="6" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <!-- Ten seconds with no answer. Text, never a placeholder that never stops. -->
      <TextBlock DockPanel.Dock="Top" Classes="secondary" Margin="16,8,16,12"
                 IsVisible="{Binding Loading.ShowError}"
                 Text="Опрос не отвечает" />

      <!-- Nothing attached. Short, because the tray is not the place to explain. -->
      <TextBlock DockPanel.Dock="Top" Classes="secondary" Margin="16,8,16,12"
                 Text="Устройств не найдено">
        <TextBlock.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!HasDevices" />
            <Binding Path="Loading.ShowContent" />
          </MultiBinding>
        </TextBlock.IsVisible>
      </TextBlock>

      <!-- Five rows of 56 and the padding they sit in. Past that the list scrolls inside
           the panel rather than the panel growing off the screen. -->
      <!-- Top, not stretched: the panel is only as tall as its rows, and a list that
           filled the space would push the footer to the bottom of the screen. -->
      <Panel VerticalAlignment="Top" IsVisible="{Binding Loading.ShowContent}">
      <ScrollViewer MaxHeight="{DynamicResource FlyoutListHeight}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Devices}" Margin="{DynamicResource FlyoutListPadding}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="devices:FlyoutRowViewModel">

              <!-- No border and no gap while closed: both are laid out, and the three
                   pixels they added put every row below the first out of step with the
                   artboard by more the further down the list it was. -->
              <Border Classes="deviceRow" Classes.open="{Binding IsOpen}"
                      CornerRadius="{DynamicResource FlyoutThumbRadiusCorner}"
                      BorderThickness="0">
                <StackPanel>

                  <!-- Height on the button, not on the grid inside it: the shared
                       navRoot style pins buttons to 36, and a setter there beats
                       anything a child asks for. This row is 56 because the artboard
                       says 56, and Metrics.axaml has that number from the design file
                       rather than from anyone's memory. -->
                  <!-- Transparent inline, not only through the class: the row sits on the
                       opened card's surface and anything the button paints of its own
                       would draw a second, lighter rectangle over the top of it. -->
                  <Button Classes="deviceRowButton" Background="Transparent"
                          Command="{Binding ToggleCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          Height="{DynamicResource FlyoutRowHeight}">
                      <Border Grid.Column="0"
                              Width="{DynamicResource FlyoutThumbSize}"
                              Height="{DynamicResource FlyoutThumbSize}"
                              Background="{DynamicResource LayerAltBrush}"
                              CornerRadius="{DynamicResource FlyoutThumbRadiusCorner}"
                              ClipToBounds="True"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center">
                        <ctl:DeviceThumb Photo="{Binding Device.Photo}" IconKey="{Binding Device.IconKey}" />
                      </Border>

                      <!-- The gap belongs to the text column rather than to the reading:
                           without it a long device name runs straight into the percentage
                           instead of being trimmed short of it. -->
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                  Margin="0,0,12,0">
                        <TextBlock FontSize="{DynamicResource FlyoutNameSize}" FontWeight="SemiBold"
                                   Text="{Binding Device.DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" FontSize="{DynamicResource FlyoutSubSize}"
                                   Text="{Binding Device.Status}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <controls:KvazrMarkControl Grid.Column="2" Width="18" Height="18"
                                                 Motion="Fast" OrbitShade="Resting"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding Device.IsBatteryPending}" />

                      <!--
                        Three readings, not one string: Turn 12 prints a percentage at
                        full weight, "от кабеля" small and grey for a device that runs off
                        the wire, and a dash for one that ought to report and does not.
                        They are different sizes and colours because they carry different
                        amounts of news — the number is what the row is for, the other two
                        are there to stop the reader waiting for a number.
                      -->
                      <!-- The cell and the number together, as every other surface draws
                           them: the gauge carries the charging bolt, so a device on a
                           cable says so without spending a word on it. -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding Device.ShowsBatteryPercent}">
                        <controls:BatteryGauge Percent="{Binding Device.BatteryPercent}"
                                               Charging="{Binding Device.IsCharging}"
                                               VerticalAlignment="Center" />
                        <TextBlock FontSize="{DynamicResource FlyoutBatterySize}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="{Binding Device.Battery}" />
                      </StackPanel>

                      <TextBlock Grid.Column="2" FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextTertiaryBrush}"
                                 IsVisible="{Binding Device.ShowsMains}"
                                 Text="от кабеля" />

                      <!-- Nothing at all where there is no reading. A dash in a column of
                           numbers reads as a value the device gave, and it gave none. -->

                      <Path Grid.Column="3" Width="10" Height="10" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                            Stretch="Uniform"
                            IsVisible="{Binding !IsOpen}"
                            Data="M3.6 6 8 10.4 12.4 6" />

                      <Path Grid.Column="3" Width="10" Height="10" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource TextPrimaryBrush}"
                            StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                            Stretch="Uniform"
                            IsVisible="{Binding IsOpen}"
                            Data="M3.6 10.4 8 6l4.4 4.4" />
                    </Grid>
                  </Button>

                  <!-- Indented to the name rather than to the edge: the controls belong
                       to the device above them, and the picture column says so. -->
                  <!-- The 2 pixels the artboard puts above the first control were drawn
                       under a taller slider row; with the rhythm tightened to the drawing
                       they left the first name sitting against the device's own. Eight
                       gives it the same air the blocks below it have. -->
                  <StackPanel IsVisible="{Binding IsOpen}" Margin="54,8,12,14" Spacing="12">

                    <!--
                      The panel's own controls, not the device page's.

                      Measured off artboard 12b rather than reused: there a slider is a
                      16-pixel caption row over an 18-pixel track row, and a choice is a
                      30-pixel row with the control 150 wide against the right edge. The
                      page's CapabilityControl is built for a 260-pixel column beside a
                      name, and dropping it in here brought its full-width dropdowns, its
                      taller sliders and its state dots into a 272-pixel body — which is
                      what made the opened row look nothing like the design.
                    -->
                    <!-- No ItemTemplate on purpose: each item is presented through the
                         implicit template for its own primitive, which is how a slider
                         and a dropdown end up drawn differently without the list knowing
                         either of them exists. -->
                    <ItemsControl ItemsSource="{Binding Quick}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>

                      <!--
                        Declared on the list itself rather than on the window. These are
                        instantiated inside the row's own template, and an implicit
                        template looked up from there does not reach the window's
                        collection — the items came out as their type names, which is what
                        a presenter prints when it finds no template at all.
                      -->
                      <!--
                        Declared on the list, beside the templates it applies to.

                        Fluent's slider stands 46 pixels tall: a 4-pixel track with a
                        header strip and a tick strip reserved around it, neither of which
                        this panel uses. The artboard gives the row 18, and the spare
                        showed up as a gap between a control and its own name wide enough
                        to look like a fault. Height does not touch it — the reservations
                        live inside the template — and the theme resources that do are
                        resolved statically inside the control theme, out of a window's
                        reach. So the spare is taken back with a negative margin, and the
                        style lives here because one declared on the window does not reach
                        inside a data template at all.
                      -->
                      <ItemsControl.Styles>
                        <Style Selector="Slider.quick">
                          <Setter Property="MinHeight" Value="0" />
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="0,-14" />
                          <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                      </ItemsControl.Styles>

                      <ItemsControl.DataTemplates>

                        <DataTemplate DataType="cap:RangeCapabilityViewModel">
                          <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto" Height="16">
                              <TextBlock Grid.Column="0" Classes="caption" FontSize="12" VerticalAlignment="Center"
                                         Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Classes="caption" FontSize="12" VerticalAlignment="Center"
                                         Margin="8,0,0,0"
                                         IsVisible="{Binding HasQuickValue}"
                                         Text="{Binding QuickValue}" />
                            </Grid>
                            <!-- An empty track holds the place until the reading lands.
                                 The row is the same height either way, so nothing jumps
                                 when the value arrives; and an empty track claims no
                                 value, where a slider parked at its minimum would. -->
                            <Border Height="18" IsVisible="{Binding !HasValue}">
                              <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                      Background="{DynamicResource StrokeStrongBrush}" Opacity="0.25" />
                            </Border>

                            <!-- The stock control, deliberately.
                                 A hand-written template held the artboard's proportions
                                 and quietly dropped what a slider is supposed to do:
                                 clicking the track no longer moved the thumb, and the
                                 keyboard and focus states went with it. Fluent's own
                                 slider keeps all of that, and being slightly taller than
                                 the drawing is the cheaper mistake. -->
                            <Slider Classes="quick"
                                    IsVisible="{Binding HasValue}"
                                    IsEnabled="{Binding CanEdit}"
                                    Minimum="{Binding Minimum}"
                                    Maximum="{Binding Maximum}"
                                    Value="{Binding Value, Mode=TwoWay}" />
                          </StackPanel>
                        </DataTemplate>

                        <DataTemplate DataType="cap:ChoiceCapabilityViewModel">
                          <Grid ColumnDefinitions="*,Auto" Height="30">
                            <TextBlock Grid.Column="0" Classes="caption" FontSize="12" VerticalAlignment="Center"
                                       Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <ComboBox Grid.Column="1" Classes="quick"
                                      PlaceholderText="…"
                                      IsEnabled="{Binding CanEdit}"
                                      ItemsSource="{Binding Options}"
                                      SelectedItem="{Binding Selected, Mode=TwoWay}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="core:CapabilityChoice">
                                  <TextBlock FontSize="12" Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </Grid>
                        </DataTemplate>

                        <DataTemplate DataType="cap:ToggleCapabilityViewModel">
                          <Grid ColumnDefinitions="*,Auto" Height="30">
                            <TextBlock Grid.Column="0" Classes="caption" FontSize="12" VerticalAlignment="Center"
                                       Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <ToggleSwitch Grid.Column="1"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsEnabled="{Binding CanEdit}"
                                          IsChecked="{Binding IsOn, Mode=TwoWay}"
                                          OnContent="" OffContent="" />
                          </Grid>
                        </DataTemplate>

                        <DataTemplate DataType="cap:ActionCapabilityViewModel">
                          <Grid ColumnDefinitions="*,Auto" Height="30">
                            <TextBlock Grid.Column="0" Classes="caption" FontSize="12" VerticalAlignment="Center"
                                       Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Classes="quick"
                                    IsEnabled="{Binding CanEdit}"
                                    Command="{Binding InvokeCommand}"
                                    Content="{Binding Label}" />
                          </Grid>
                        </DataTemplate>

                      </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <!-- Said out loud rather than left blank. "Connected, and there is
                         nothing here to set" is something a person can act on; an empty
                         gap under an opened row reads as a fault. -->
                    <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding HasNothing}"
                               Text="{Binding NothingSaid}" />

                    <!-- A line of text with a chevron, not a filled button: the artboard
                         gives this the weight of a link, and the navRoot class would put
                         a 36-pixel control under every opened row. -->
                    <!-- Set on the element, not only through the class: the button theme
                         paints a surface of its own, and this has to read as a line of
                         text rather than as a control. -->
                    <!-- Pulled back by its own padding so the text still lines up with
                         the controls above it while the hover fills the whole row. -->
                    <Button Classes="quietLink"
                            Background="Transparent" BorderThickness="0"
                            Margin="-8,0"
                            Command="{Binding OpenPageCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsVisible="{Binding !HasNothing}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="Открыть страницу устройства" />
                        <Path Grid.Column="1" Width="10" Height="10" VerticalAlignment="Center"
                              Stroke="{DynamicResource TextTertiaryBrush}"
                              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                              Stretch="Uniform"
                              Data="M6 3.6 10.4 8 6 12.4" />
                      </Grid>
                    </Button>
                  </StackPanel>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

        <!-- The list runs under the footer rather than stopping dead at it, so the last
             row visibly continues. Painted in the sheet's own tint so it reads as the
             panel closing over the list, not as a grey bar laid on top of it. -->
        <Border Height="26" VerticalAlignment="Bottom" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="{DynamicResource FlyoutFadeStartColor}" />
              <GradientStop Offset="1" Color="{DynamicResource FlyoutFadeEndColor}" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Panel>

    </DockPanel>
    </Border>
  </Panel>

</Window>
