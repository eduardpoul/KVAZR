<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Maxwell.App.ViewModels"
        xmlns:pages="using:Maxwell.App.ViewModels.Pages"
        xmlns:devices="using:Maxwell.App.ViewModels.Devices"
        xmlns:views="using:Maxwell.App.Views.Pages"
        xmlns:controls="using:Maxwell.App.Controls"
        x:Class="Maxwell.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="KVAZR"
        Icon="/Assets/kvazr.ico"
        Width="1040" Height="720"
        MinWidth="880" MinHeight="560"
        Background="{DynamicResource LayerBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="{DynamicResource FontSizeBody}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowDecorations="BorderOnly">

  <!-- Three templates for the whole application. There is no per-model page: a device
       page is assembled from what the device declares, whatever vendor made it. -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="devices:DevicePageViewModel"><views:DevicePageView /></DataTemplate>
    <DataTemplate DataType="pages:CapabilityShowcaseViewModel"><views:CapabilityShowcaseView /></DataTemplate>
    <DataTemplate DataType="pages:IdentityViewModel"><views:IdentityView /></DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>

    <!-- Window chrome buttons: flat, 46px wide, close turns red like the mock-up. -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LayerHoverBrush}" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="TextBlock.groupHeader">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="12,10,12,4" />
    </Style>

    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="48,*">

    <!-- Title bar -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
          Background="Transparent"
          PointerPressed="OnTitleBarPressed">

      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                  Margin="16,0,0,0" VerticalAlignment="Center">
        <!-- The mark itself, not a letter in a box. It is 18 px here, above the
             identity's 16-pixel floor, and it is the same drawing as the tray icon. -->
        <controls:KvazrMarkControl x:Name="TitleMark" Width="18" Height="18"
                                   State="AllConnected"
                                   VerticalAlignment="Center" />
        <TextBlock Text="KVAZR" FontSize="{DynamicResource FontSizeSmall}"
                   LetterSpacing="1.3"
                   VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Classes="chrome" Content="&#x2500;" Click="OnMinimise" />
        <Button Classes="chrome" Content="&#x25A1;" Click="OnMaximise" />
        <Button Classes="chrome close" Content="&#x2715;" Click="OnHide" />
      </StackPanel>
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="260,*">

      <ScrollViewer Grid.Column="0" Padding="8,0,8,12">
        <StackPanel Spacing="2">

          <TextBox Classes="search" Watermark="Поиск"
                   Text="{Binding SearchText}"
                   Margin="4,0,4,6" />

          <Button Classes="navRoot" Command="{Binding ShowDashboardCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <TextBlock Text="Все устройства" Margin="8,0" />
          </Button>

          <TextBlock Classes="groupHeader" Text="УСТРОЙСТВА"
                     IsVisible="{Binding HasDevices}" />

          <ListBox Classes="nav"
                   ItemsSource="{Binding Devices}"
                   SelectedItem="{Binding SelectedDevice}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="devices:DeviceListItemViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Battery}"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="groupHeader" Text="ПРИЛОЖЕНИЕ" />

          <ListBox Classes="nav"
                   ItemsSource="{Binding AppSections}"
                   SelectedItem="{Binding SelectedAppSection}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AppSection">
                <TextBlock Text="{Binding Title}" Margin="12,0" VerticalAlignment="Center" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </StackPanel>
      </ScrollViewer>

      <!-- Content -->
      <ScrollViewer Grid.Column="1" x:Name="ContentPane" Padding="12,0,24,24">
        <StackPanel Spacing="16">
          <TextBlock Classes="sectionTitle" Text="{Binding HeaderTitle}" Margin="0,4,0,0" />
          <ContentControl Content="{Binding CurrentPage}" />
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>

</Window>
