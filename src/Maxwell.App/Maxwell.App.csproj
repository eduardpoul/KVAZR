<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Razor SDK, because the UI is HTML now: the content pane is Razor components in
    a WebView2, bound straight to the same view models the Avalonia views used. The SDK
    change is what lets the components live in this project and bind directly — the
    experiment phase proved the approach through an adapter layer, and the adapter was
    the first thing to die on the way to production.

    Avalonia remains the shell: the window, the tray, the flyout, the global hotkeys,
    the toasts. None of that wants to be a web page, and all of it already works.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!--
      Two targets. The Windows one is pinned to windows10.0.17763 because that is the
      floor of the toast implementation; the plain net10.0 one is what Linux and macOS
      build against. Keeping both compiling on every build is the point — it is what
      stops the Windows path quietly growing dependencies the others cannot satisfy.
    -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>

    <RootNamespace>Maxwell.App</RootNamespace>
    <AssemblyName>Maxwell</AssemblyName>

    <!--
      The name the user sees. Only this: the assembly, the namespaces and the project
      keep their old names on purpose, because renaming them renames the process, the
      settings folder and the autostart registry value, and the last of those would
      leave every existing installation launching a name that no longer exists.
    -->
    <AssemblyTitle>KVAZR</AssemblyTitle>
    <ApplicationIcon>Assets\kvazr.ico</ApplicationIcon>

    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- CA1822 wants constant view-model properties made static, but XAML bindings
         only resolve instance members, so following it would break the binding. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>

    <!-- The WinForms analyzer wants DPI configured its way; Avalonia owns DPI in this
         process and WinForms is a guest inside one HWND. -->
    <NoWarn Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    Single-file publish. Conditioned on PublishSingleFile so an ordinary build stays
    RID-agnostic and both target frameworks keep compiling; these only apply when the
    publish command asks for one file.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>

    <!-- Skia and HarfBuzz are native libraries. Without self-extract they are written
         beside the exe and the "single file" is three dozen of them. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      Compression is deliberately OFF. It cuts the file from 134 MB to 55 MB, but a
      compressed assembly cannot be mapped from the bundle, so the runtime decompresses
      it into private memory instead: measured idle in the tray, 86 MB private working
      set with compression against 47 MB without, and double the startup CPU. Memory
      and CPU are the budget that matters here; disk is not.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!-- Both targets compile the Razor components — that is what keeps the plain
         net10.0 build honest about them — but only Windows carries the WebView host. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <!--
    The web content pane is Windows-only for now: its host is the WinForms
    BlazorWebView. The plain net10.0 build keeps compiling with the native views, which
    is the cross-platform fallback until a WebKit host exists for it.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">
    <PackageReference Include="DesktopNotifications" />
    <PackageReference Include="DesktopNotifications.Windows" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" GeneratePathProperty="true" />

    <!-- The WinForms SDK injects its namespaces as global usings, and both collide
         with Avalonia's (Application, Color, Point) across the whole project. The one
         file that talks to WinForms names its types explicitly instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    The framework script ships as a static web asset and resolves through a manifest at
    runtime; with the Razor SDK on this project the manifest exists, but the published
    layout is simpler to reason about with the script as a plain file — and the plain
    file is what the experiment proved works. Carried explicitly.
  -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">
    <None Include="$(PkgMicrosoft_AspNetCore_Components_WebView)/staticwebassets/blazor.webview.js"
          Link="wwwroot/_framework/blazor.webview.js"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_AspNetCore_Components_WebView)/staticwebassets/blazor.modules.json"
          Link="wwwroot/_framework/blazor.modules.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maxwell.Core\Maxwell.Core.csproj" />
  </ItemGroup>

  <!-- The identity's colour table, the tray's state reduction and the skeleton timing
       rules are all internal, and all worth testing. Widening them to public so a test
       can reach them would put three implementation details on the assembly's surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Maxwell.App.Tests" />
  </ItemGroup>

  <!--
    SkiaSharp and HarfBuzz ship native debug symbols: 105 MB of .pdb that a release
    build has no use for, and nearly half the published size. Trimming is deliberately
    NOT used instead — Avalonia resolves controls and styles reflectively, so a trimmed
    build fails at runtime rather than at publish time.
  -->
  <Target Name="DropSymbolsFromRelease"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
