@* The sound section, drawn from the same numbers as the artboard: 64px rows inside one
   card, hairlines between them, the control column on the right. The rules mirror the
   native CapabilityRow exactly — an unreachable capability is one quiet line in place
   of its control, a slider is hidden until it has a reading, the amber dot marks a
   command never confirmed on hardware. *@

<div class="page @(Source.IsDark ? "dark" : "light")">
  <div class="section">
    <div class="heading">@Source.Heading</div>
    <div class="card">
      @foreach (var row in Source.Rows)
      {
        <div class="row">
          <div class="text">
            <div class="title">@row.Title</div>
            @if (!string.IsNullOrEmpty(row.Subtitle))
            {
              <div class="caption">@row.Subtitle</div>
            }
          </div>

          <div class="control">
            @switch (row.Kind)
            {
              case "blocked":
                <div class="blocked">@row.Unreachable</div>
                break;

              case "readout":
                <div class="value">@row.Display</div>
                break;

              case "choice":
                <select disabled="@(!row.CanEdit)"
                        @onchange="e => row.Choose(int.Parse((string)e.Value!))">
                  @for (int i = 0; i < row.Options.Count; i++)
                  {
                    <option value="@i" selected="@(i == row.SelectedIndex)">@row.Options[i]</option>
                  }
                </select>
                break;

              case "range":
                <div class="range">
                  <div class="reading">@row.Display</div>
                  @if (row.HasValue)
                  {
                    <input type="range"
                           min="@row.Minimum" max="@row.Maximum" step="1"
                           value="@row.Value"
                           disabled="@(!row.CanEdit)"
                           style="--fill: @(Percent(row))%"
                           @oninput="e => row.SetValue(double.Parse((string)e.Value!))" />
                  }
                </div>
                break;
            }

            @if (row.IsUntested && row.Kind != "blocked")
            {
              <span class="dot" title="Ещё не проверено на живом устройстве"></span>
            }

            @if (!string.IsNullOrEmpty(row.Hint))
            {
              <div class="hint">@row.Hint</div>
            }
          </div>
        </div>
      }
    </div>
  </div>
</div>

@code {
  [Parameter, EditorRequired]
  public ISoundSectionSource Source { get; set; } = default!;

  protected override void OnInitialized() =>
      Source.Changed += () => _ = InvokeAsync(StateHasChanged);

  private static double Percent(ISoundRow row) =>
      row.Maximum > row.Minimum
          ? Math.Round((row.Value - row.Minimum) / (row.Maximum - row.Minimum) * 100, 1)
          : 0;
}
