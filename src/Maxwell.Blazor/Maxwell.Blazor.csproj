<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    An experiment, honestly labelled as one: the sound section of a device page, laid
    out in HTML inside a WebView2 and parented into the Avalonia window by HWND. It
    exists to answer a single question — whether the web stack reproduces the design
    faster or better than the Avalonia layout that mirrors it.

    Deliberately independent of the application: the component binds to two small
    interfaces declared here, and the application adapts its view models to them. The
    other direction would be a circular reference, and a web experiment that can see
    the whole application is also one that quietly starts depending on it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" />

    <!-- Direct, for the path property below. The version is the one the WinForms
         package resolves anyway; this only pins where on disk it is. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    The framework script ships as a static web asset, and static web assets resolve at
    runtime through a manifest named after the entry assembly — which here is the
    application, a plain-SDK project that has no such manifest. Rather than convert the
    whole application to the Razor SDK for one experiment, the script is placed as an
    ordinary file: the host serves physical files from the content root after the
    manifest lookup misses, so wwwroot/_framework/blazor.webview.js simply works.
  -->
  <ItemGroup>
    <None Include="$(PkgMicrosoft_AspNetCore_Components_WebView)\staticwebassets\blazor.webview.js"
             Link="wwwroot\_framework\blazor.webview.js"
             CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_AspNetCore_Components_WebView)\staticwebassets\blazor.modules.json"
          Link="wwwroot\_framework\blazor.modules.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
