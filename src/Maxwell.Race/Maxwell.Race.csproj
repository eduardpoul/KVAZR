<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- LibraryImport generates pointer-based marshalling, which needs this. The
         project is raw P/Invoke throughout, so it is consistent rather than a
         concession. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Maxwell.Race</RootNamespace>
  </PropertyGroup>

</Project>
