<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cap="using:Kvazr.App.ViewModels.Capabilities"
             xmlns:controls="using:Kvazr.App.Controls"
             x:Class="Kvazr.App.Controls.CapabilityRow"
             x:DataType="cap:CapabilityViewModel">

  <!--
    One capability as a page row: name and explanation on the left, the control and its
    state on the right. This is the only row layout in the application — a headset, a
    mouse and a keyboard all lay out through it, which is what keeps them looking like
    one program.
  -->

  <!--
    The control column is a fixed width rather than sized to its content, and that is the
    whole reason the page reads as a list. With every control right-aligned to its own
    width, a row of sliders and a row of switches start at different places and the eye
    has to find the column again on every line.

    Except where the control is not that shape. A host list, a button map, a key map, a
    curve and a set of colour zones are each a small table, and 260 pixels does not make
    one tidy — it makes it unreadable and then clips the rest off the edge of the card.
    Those get the full width under their own name, which is how artboards 9b and 9c draw
    them.

    MinHeight rather than Height: the artboard's 64 is what a one- or two-line row comes
    to, and anything taller is taller.
  -->
  <!-- The first row takes the slack, so a one-line row's content sits in the middle of
       its 64 pixels rather than at the top of them with the rest left empty below. -->
  <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto"
        MinHeight="{DynamicResource PageRowHeight}">

    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2"
                VerticalAlignment="Center"
                Margin="{DynamicResource PageRowGapRight}">
      <TextBlock FontSize="{DynamicResource PageRowTitleSize}" Text="{Binding Title}" />
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Text="{Binding Subtitle}"
                 IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <controls:CapabilityControl Grid.Row="0" Grid.Column="1"
                                IsVisible="{Binding !IsWide}"
                                Width="{DynamicResource PageControlWidth}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />

    <controls:CapabilityControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                IsVisible="{Binding IsWide}"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,4" />
  </Grid>

</UserControl>
