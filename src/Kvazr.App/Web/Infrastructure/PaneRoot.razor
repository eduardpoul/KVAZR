@namespace Kvazr.App.Web
@inherits ReactiveComponent

@* The whole content pane. One root for the lifetime of the window: it listens to the
   shell and swaps pages itself, so navigation costs a render and not a WebView boot. *@

<div class="page @(Theme.IsDark ? "dark" : "")">
  @switch (Shell.CurrentPage)
  {
    case DashboardViewModel dashboard:
      <DashboardPage Shell="Shell" Vm="dashboard" />
      break;

    case DevicePageViewModel device:
      <DevicePage Shell="Shell" Vm="device" />
      break;

    case SettingsViewModel settings:
      <SettingsPage Vm="settings" />
      break;

    case AboutViewModel about:
      <AboutPage Vm="about" />
      break;

    case HotkeysViewModel hotkeys:
      <HotkeysPage Vm="hotkeys" />
      break;

    default:
      @* The identity sheet and the capability matrix stay native — they are internal
         drawings of Avalonia controls, and the window shows the native pane for them. *@
      break;
  }
</div>

@code {
  [Parameter, EditorRequired] public ShellViewModel Shell { get; set; } = default!;

  [Parameter, EditorRequired] public WebTheme Theme { get; set; } = default!;

  protected override void OnInitialized()
  {
    Track(Shell);
    Track(Theme);
  }
}
