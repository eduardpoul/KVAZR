<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kvazr.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kvazr.Race\Kvazr.Race.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalogue travels inside the assembly so Core stays self-contained and
         testable without a file path. When it outgrows a binary it becomes a document
         fetched from a repository, and nothing above IDeviceCatalogue notices. -->
    <EmbeddedResource Include="Catalogue/devices.json" />
  </ItemGroup>

  <!-- A driver's own types are internal and stay that way: nothing outside this assembly
       has any business constructing a lighting frame or a device's state record. The
       arithmetic inside them is exactly what is worth checking, though — an effect is a
       function of time, and a function of time can be checked exactly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Kvazr.Core.Tests" />
  </ItemGroup>

</Project>
